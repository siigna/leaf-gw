 import crcmod
-from selfdrive.car.nissan.values import CAR
+from common.numpy_fast import clip
+from selfdrive.car.nissan.values import CAR, CarControllerParams
+
+# Bus the leaf-gw gateway taps to read the longitudinal frames (V-CAN; the comma
+# already drives it for steering). Which V-CAN segment / panda bus is a bench check.
+LEAF_LONG_BUS = 2
+# The gateway's 50 Hz heartbeat on LEAF_LONG_BUS (50 Hz so the 0.1 s fingerprint window sees it): longitudinal is offered only when
+# the fingerprint saw it, and panda drops control if it stops.
+LEAF_GW_HEARTBEAT = 0x5FF
 
 nissan_checksum = crcmod.mkCrcFun(0x11d, initCrc=0x00, rev=False, xorOut=0xff)
 
@@ -69,3 +77,36 @@ def create_lkas_hud_info_msg(packer, lkas_hud_info_msg, steer_hud_alert):
     values["HANDS_ON_WHEEL_WARNING"] = 1
 
   return packer.make_can_msg("PROPILOT_HUD_INFO_MSG", 0, values)
+
+
+def create_accel_command(command, frame, active):
+  """Leaf ADAS propulsion/regen request (0x2B0) for T = command (higher T = more
+  deceleration). leaf-gw re-stamps the counter and re-emits it on Chassis CAN."""
+  t = int(clip(int(command), 0, 4095))
+  # T = dat[2] << 4 | dat[1] low nibble; inverted copy in dat[1] high nibble + dat[0]
+  inverse = (~t) & 0xFFF
+  aux = 2 if t == CarControllerParams.PROPILOT_BRAKE_RAW else 0  # stock pairs the marker with aux 2
+  dat = bytes([
+    inverse & 0xFF,
+    (((inverse >> 8) & 0xF) << 4) | (t & 0xF),
+    (t >> 4) & 0xFF,
+    0xAC,
+    0x5B if active else 0x1B,
+    0x00,
+    ((frame & 0xF) << 4) | 0xE,
+    (aux << 2) | ((~aux) & 0x3),
+  ])
+  return [0x2B0, 0, dat, LEAF_LONG_BUS]
+
+
+def create_brake_command(pressure, frame, active, brake_mode):
+  """Leaf ADAS friction-brake request (0x1C3), pressure in 0.5-count units."""
+  pressure = int(pressure)
+  dat = bytearray(8)
+  dat[0] = (pressure >> 4) & 0x3F
+  dat[1] = (pressure & 0xF) << 4
+  dat[4] = 0x64
+  dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0) | (frame & 0x3)
+  dat[6] = 0xFF
+  dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+  return [0x1C3, 0, bytes(dat), LEAF_LONG_BUS]
