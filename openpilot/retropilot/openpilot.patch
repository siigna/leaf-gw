new file mode 100644
index 0000000..e56b711
--- /dev/null
+++ b/selfdrive/car/tests/test_nissan_leaf_gw.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+# Nissan Leaf longitudinal via the leaf-gw gateway (github.com/siigna/leaf-gw).
+import importlib.util
+import unittest
+from unittest import mock
+
+from cereal import car
+from panda import Panda
+from selfdrive.car import gen_empty_fingerprint
+from selfdrive.car.nissan.carcontroller import CarController
+from selfdrive.car.nissan.carstate import CarState
+from selfdrive.car.nissan.interface import CarInterface
+from selfdrive.boardd.boardd import can_list_to_can_capnp
+from selfdrive.car.nissan.nissancan import LEAF_FEEDBACK_ADDR, LEAF_GW_HEARTBEAT, LEAF_LONG_BUS, create_accel_command, create_brake_command
+from selfdrive.car.nissan.values import DBC
+from opendbc.can.packer import CANPacker
+from selfdrive.car.nissan.values import CAR, CarControllerParams as P
+
+LongCtrlState = car.CarControl.Actuators.LongControlState
+EventName = car.CarEvent.EventName
+LEAFS = (CAR.LEAF, CAR.LEAF_IC)
+# leaf-gw's dependency-free spec, when copied next to the port (leaf-gw/openpilot/leaf_gw_long.py)
+HAVE_SPEC = importlib.util.find_spec("selfdrive.car.nissan.leaf_gw_long") is not None
+
+
+def _fp(heartbeat_bus=LEAF_LONG_BUS, feedback_buses=(0, 1)):
+  fp = gen_empty_fingerprint()
+  if heartbeat_bus is not None:
+    fp[heartbeat_bus][LEAF_GW_HEARTBEAT] = 8
+  for b in feedback_buses:
+    fp[b][LEAF_FEEDBACK_ADDR] = 8
+  return fp
+
+
+def _params(candidate, fp, toggle):
+  with mock.patch("selfdrive.car.nissan.interface.Params") as params:
+    params.return_value.get_bool.side_effect = lambda k: toggle and k == "DisableRadar"
+    return CarInterface.get_params(candidate, fp)
+
+
+def _decode_2b0(d):
+  t = (d[2] << 4) | (d[1] & 0xF)
+  assert ((d[1] >> 4) << 8) | d[0] == (~t) & 0xFFF, "0x2B0 inverse copy"
+  aux = (d[7] >> 2) & 0x3
+  assert d[7] == (aux << 2) | (~aux & 0x3), "0x2B0 aux check"
+  assert aux == (2 if t == P.PROPILOT_BRAKE_RAW else 0)
+  return t
+
+
+def _decode_1c3(d):
+  assert d[7] == (0x01 + 0xC3 + sum(d[:7])) & 0xFF, "0x1C3 checksum"
+  return ((d[0] & 0x3F) << 4) | (d[1] >> 4)
+
+
+class TestNissanLeafGw(unittest.TestCase):
+  def test_long_needs_toggle_and_heartbeat(self):
+    for candidate in LEAFS:
+      for toggle in (False, True):
+        for hb_bus in (None, 0, 1, LEAF_LONG_BUS):
+          CP = _params(candidate, _fp(hb_bus), toggle)
+          want = toggle and hb_bus == LEAF_LONG_BUS
+          self.assertEqual(want, CP.openpilotLongitudinalControl, (candidate, toggle, hb_bus))
+          self.assertEqual(want, bool(CP.safetyConfigs[0].safetyParam & Panda.FLAG_NISSAN_LEAF_LONG))
+          self.assertFalse(CP.safetyConfigs[0].safetyParam & Panda.FLAG_NISSAN_ALT_EPS_BUS)
+          # stock ProPILOT engagement gates control: openpilot would cancel it otherwise
+          self.assertTrue(CP.pcmCruise)
+
+  def test_long_needs_feedback_on_harness_bus(self):
+    # 0x180 must be on the harness's bus: 0 for the Nissan A harness (LEAF), 1 for IC
+    for candidate, fb_bus in ((CAR.LEAF, 0), (CAR.LEAF_IC, 1)):
+      self.assertTrue(_params(candidate, _fp(feedback_buses=(fb_bus,)), True).openpilotLongitudinalControl)
+      for wrong in ((), (1 - fb_bus,), (LEAF_LONG_BUS,)):
+        self.assertFalse(_params(candidate, _fp(feedback_buses=wrong), True).openpilotLongitudinalControl, (candidate, wrong))
+
+  def test_fingerprint_without_gateway_bus(self):
+    # a fingerprint dict that never saw bus 2 at all must not raise, just disable long
+    CP = _params(CAR.LEAF, {0: {LEAF_GW_HEARTBEAT: 8}, 1: {}}, True)
+    self.assertFalse(CP.openpilotLongitudinalControl)
+
+  def test_no_long_on_other_nissans(self):
+    for candidate in (CAR.ROGUE, CAR.XTRAIL, CAR.ALTIMA):
+      CP = _params(candidate, _fp(), True)
+      self.assertFalse(CP.openpilotLongitudinalControl)
+      want = Panda.FLAG_NISSAN_ALT_EPS_BUS if candidate == CAR.ALTIMA else 0
+      self.assertEqual(want, CP.safetyConfigs[0].safetyParam)
+
+  def test_pid_accel_limits(self):
+    CP = _params(CAR.LEAF, _fp(), True)
+    self.assertEqual((P.ACCEL_MIN, P.ACCEL_MAX), CarInterface.get_pid_accel_limits(CP, 10., 20.))
+    CP = _params(CAR.LEAF, _fp(), False)
+    self.assertNotEqual((P.ACCEL_MIN, P.ACCEL_MAX), CarInterface.get_pid_accel_limits(CP, 10., 20.))
+
+  def test_frames_match_stock(self):
+    # stock ZE1 frames (public route): idle, friction-brake marker, neutral
+    self.assertEqual("dc53a2ac1b000e03", create_accel_command(P.PROPILOT_INACTIVE_RAW, 0, False)[2].hex())
+    self.assertEqual("a827d5ac5b000e09", create_accel_command(P.PROPILOT_BRAKE_RAW, 0, True)[2].hex())
+    self.assertEqual("ff6090ac5b000e03", create_accel_command(2304, 0, True)[2].hex())
+    for t in range(4096):
+      self.assertEqual(t, _decode_2b0(create_accel_command(t, t, t % 2 == 0)[2]))
+    for p in range(0, P.BRAKE_MAX + 1):
+      self.assertEqual(p, _decode_1c3(create_brake_command(p, 3, p > 0, p > 0)[2]))
+
+  def _run(self, CI, accel, active, stopping, v_ego):
+    CC = car.CarControl.new_message()
+    CC.enabled = CC.active = active
+    CC.actuators.accel = accel
+    CC.actuators.longControlState = LongCtrlState.stopping if stopping else (LongCtrlState.pid if active else LongCtrlState.off)
+    CI.CS.out = car.CarState.new_message(vEgo=v_ego).as_reader()
+    frame = CI.frame
+    _, sends = CI.apply(CC)
+    long_sends = {m[0]: m for m in sends if m[0] in (0x2B0, 0x1C3)}
+    return frame, long_sends
+
+  def _ci(self, toggle=True, candidate=CAR.LEAF):
+    CP = _params(candidate, _fp(), toggle)
+    CI = CarInterface(CP, CarController, CarState)
+    CI.update(car.CarControl.new_message(), [])
+    return CI
+
+  def test_controller_emits_long_frames(self):
+    CI = self._ci()
+    for accel, active, stopping, v_ego, cmd, pressure in (
+        (0.0, True, False, 10., 2528, 0),
+        (0.79, True, False, 10., 2272, 0),
+        (2.0, True, False, 10., 2272, 0),  # clipped to ACCEL_MAX
+        (-0.45, True, False, 10., 2720, 0),
+        (-0.78, True, False, 10., 2784, 0),
+        (-2.0, True, False, 10., P.PROPILOT_BRAKE_RAW, round((2.0 - 0.78) * P.BRAKE_GAIN)),
+        (-9.0, True, False, 10., P.PROPILOT_BRAKE_RAW, P.BRAKE_MAX),  # clipped to -3.5: 718 -> 659
+        (0.0, True, True, 0.1, P.PROPILOT_BRAKE_RAW, P.BRAKE_MAX),  # standstill hold
+        (1.0, False, False, 10., P.PROPILOT_INACTIVE_RAW, 0),
+        (-3.0, False, False, 10., P.PROPILOT_INACTIVE_RAW, 0),
+    ):
+      _, sends = self._run(CI, accel, active, stopping, v_ego)
+      self.assertEqual({0x2B0, 0x1C3}, set(sends))
+      for m in sends.values():
+        self.assertEqual(LEAF_LONG_BUS, m[3])
+      self.assertEqual(cmd, _decode_2b0(sends[0x2B0][2]), (accel, active, stopping))
+      self.assertEqual(pressure, _decode_1c3(sends[0x1C3][2]), (accel, active, stopping))
+      self.assertEqual(active, bool(sends[0x2B0][2][4] & 0x40))
