+class TestNissanLeafGwFollow(unittest.TestCase):
+  """End to end through the interface: 0x180 on bus 0 -> CarState -> FollowMonitor -> accFaulted."""
+  BUS0 = ("STEER_ANGLE_SENSOR", "ESP", "GEARBOX", "DOORS_LIGHTS", "LIGHTS", "BRAKE_PEDAL", "CRUISE_THROTTLE",
+          "CANCEL_MSG", "HUD_SETTINGS", "SEATBELT", "STEER_TORQUE_SENSOR")
+
+  def _drive(self, car_t, accel, frames=200, dt=0.01):
+    """openpilot asks for `accel`; the car reports (via 0x180) acting on T `car_t`, with the
+    controller stepped every `dt` s of (simulated) monotonic time. Returns (time, accFaulted) per frame."""
+    CI = CarInterface(_params(CAR.LEAF, _fp(), True), CarController, CarState)
+    packer = CANPacker(DBC[CAR.LEAF]["pt"])
+    CC = car.CarControl.new_message()
+    CC.enabled = CC.active = True
+    CC.actuators.accel = accel
+    CC.actuators.longControlState = LongCtrlState.pid
+    d = round(-0.796 * car_t + 2067.1)
+    front, rear = ({f"WHEEL_SPEED_{w}": 36 for w in ws} for ws in (("FL", "FR"), ("RL", "RR")))  # 36 km/h = 10 m/s
+    out_faults, clock = [], [100.0]
+    with mock.patch("selfdrive.car.nissan.carcontroller.sec_since_boot", lambda: clock[0]):
+      for _ in range(frames):
+        msgs = [packer.make_can_msg(m, 0, {}) for m in self.BUS0]
+        msgs += [packer.make_can_msg("WHEEL_SPEEDS_FRONT", 0, front), packer.make_can_msg("WHEEL_SPEEDS_REAR", 0, rear),
+                 packer.make_can_msg("PROPULSION_FEEDBACK", 0, {"D": d})]
+        out = CI.update(CC, [can_list_to_can_capnp(msgs)])
+        self.assertIsNotNone(CI.CS.leaf_feedback)
+        self.assertAlmostEqual(car_t, CI.CS.leaf_feedback, delta=1)
+        out_faults.append((clock[0] - 100.0, EventName.accFaulted in [e.name for e in out.events]))
+        CI.apply(CC)
+        clock[0] += dt
+    return out_faults
+
+  def test_faults_when_car_slows_less_than_asked(self):
+    # openpilot asks for -0.5 m/s^2 (T ~2730) but the car acts on T 2528 (~0): not relaying.
+    # Same timing (LAG 0.16 s + WINDOW 1.0 s, seen one step later) at 100 Hz and 50 Hz.
+    for dt in (0.01, 0.02):
+      faults = self._drive(car_t=2528, accel=-0.5, frames=round(2.0 / dt), dt=dt)
+      first = next(t for t, f in faults if f)
+      self.assertTrue(1.1 <= first <= 1.3, (dt, first))
+      self.assertTrue(all(f for t, f in faults if t >= first))  # latched
+
+  def test_quiet_when_car_follows_or_slows_more(self):
+    self.assertFalse(any(f for _, f in self._drive(car_t=2730, accel=-0.5)))   # follows
+    self.assertFalse(any(f for _, f in self._drive(car_t=2784, accel=0.0)))    # slows more than asked: stock winning
+
+  def test_monitor_rules(self):
+    # mirrors leaf-gw/openpilot/test_leaf_gw_long.py
+    from selfdrive.car.nissan.carcontroller import FollowMonitor as M
+
+    def run(op, fb, secs, evaluate=True, mon=None, dt=0.01, t=0.0):
+      mon = mon or M()
+      f = False
+      for i in range(round(secs / dt)):
+        f = mon.update(op, fb, True, evaluate, t + i * dt)
+      return f, mon
+
+    for dt in (0.01, 0.02):
+      self.assertFalse(run(2600, 2600, 5, dt=dt)[0])
+      self.assertFalse(run(2600, 2600 - M.TOL, 5, dt=dt)[0])
+      self.assertTrue(run(2700, 2600, M.LAG + M.WINDOW + 2 * dt, dt=dt)[0])
+      self.assertFalse(run(2700, 2600, M.LAG + M.WINDOW - 2 * dt, dt=dt)[0])
+      self.assertFalse(run(2500, 2800, 5, dt=dt)[0])                    # slows more: fine
+      self.assertFalse(run(2700, 2600, 5, evaluate=False, dt=dt)[0])
+      self.assertFalse(run(2700, None, 5, dt=dt)[0])                    # no feedback
+      self.assertFalse(run(P.PROPILOT_BRAKE_RAW, 2600, 5, dt=dt)[0])
+    f, mon = run(2700, 2600, 3)
+    self.assertTrue(f and mon.update(2700, 2700, True, True, 3.0))      # latched while active
+    self.assertFalse(mon.update(2700, 2700, False, True, 3.01))         # cleared when long goes inactive
+    # no clock: can't check, but must never raise (and resets like inactive)
+    f, mon = run(2700, 2600, 3)
+    self.assertTrue(f)
+    self.assertFalse(mon.update(2700, 2600, True, True, None))
+    self.assertFalse(M().update(2700, 2600, True, True, None))
+    # the lag really is in time: op stepped from 2600 to 2700 only 0.1 s ago is not yet compared
+    mon = M()
+    for i in range(300):
+      mon.update(2600, 2600, True, True, i * 0.01)
+    for i in range(10):
+      self.assertFalse(mon.update(2700, 2600, True, True, 3.0 + i * 0.01))
+      self.assertIsNone(mon.bad_since)
+    # brake marker anywhere in the LAG history skips the check
+    mon = M()
+    run(P.PROPILOT_BRAKE_RAW, 2600, 1, mon=mon)
+    self.assertFalse(run(2700, 2600, 0.1, mon=mon, t=1.0)[0])
+    self.assertIsNone(mon.bad_since)
+
+
