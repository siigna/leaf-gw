+  # Leaf ProPILOT longitudinal via leaf-gw. Friction braking (0x1C3) blends in below
+  # PROPILOT_ACCEL_MIN with StarPilot's (unverified) pressure gain.
+  # 0x2B0 T: higher = more deceleration. accel -> T is the median of 37 stock Leafs'
+  # ICC logs (commaCarSegments, accel from wheel speed); PROVISIONAL until bench-tested.
+  ACCEL_MIN = -3.5
+  ACCEL_BP = [-0.78, -0.45, -0.11, -0.04, 0.0, 0.05, 0.09, 0.59, 0.79]
