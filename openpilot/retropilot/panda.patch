diff --git a/tests/safety/test_nissan.py b/tests/safety/test_nissan.py
index 36778e4..6f9f7a8 100755
--- a/tests/safety/test_nissan.py
+++ b/tests/safety/test_nissan.py
@@ -4,7 +4,7 @@ import numpy as np
 from panda import Panda
 from panda.tests.safety import libpandasafety_py
 import panda.tests.safety.common as common
-from panda.tests.safety.common import CANPackerPanda
+from panda.tests.safety.common import CANPackerPanda, UNSAFE_MODE, make_msg, package_can_msg
 
 ANGLE_DELTA_BP = [0., 5., 15.]
 ANGLE_DELTA_V = [5., .8, .15]     # windup limit
@@ -167,5 +167,148 @@ class TestNissanLeafSafety(TestNissanSafety):
   def test_acc_buttons(self):
     pass
 
+
+class TestNissanLeafLongSafety(TestNissanLeafSafety):
+  """Leaf longitudinal via the leaf-gw gateway (github.com/siigna/leaf-gw). openpilot
+  TXes the real 0x2B0 / 0x1C3 on the gateway bus; panda bounds them, gates them on
+  controls_allowed and gas-not-pressed, and requires the gateway's 0x5FF heartbeat."""
+
+  TX_MSGS = TestNissanLeafSafety.TX_MSGS + [[0x2b0, 2], [0x1c3, 2]]
+
+  # mirrors CarControllerParams in selfdrive/car/nissan/values.py
+  GW_BUS = 2
+  MAX_GAS = 8191
+  MIN_GAS = 2398
+  INACTIVE_GAS = 5260
+  MAX_BRAKE = 659
+
+  def setUp(self):
+    self.packer = CANPackerPanda("nissan_leaf_2018")
+    self.safety = libpandasafety_py.libpandasafety
+    self.safety.set_safety_hooks(Panda.SAFETY_NISSAN, Panda.FLAG_NISSAN_LEAF_LONG)
+    self.safety.init_tests()
+
+  def _accel_msg(self, raw_command, active=True):
+    raw12, fraction = divmod(int(raw_command), 4)
+    inverse = (~raw12) & 0xFFF
+    dat = bytes([
+      inverse & 0xFF,
+      (((raw12 >> 8) & 0xF) << 4) | (raw12 & 0xF),
+      (((inverse >> 8) & 0xF) << 4) | ((raw12 >> 4) & 0xF),
+      0xAC, 0x5B if active else 0x1B, 0x00, 0x0E,
+      (fraction << 2) | ((~fraction) & 0x3),
+    ])
+    return package_can_msg([0x2b0, 0, dat, self.GW_BUS])
+
+  def _brake_cmd_msg(self, pressure, active=True, brake_mode=False):
+    pressure = int(pressure)
+    dat = bytearray(8)
+    dat[0] = (pressure >> 4) & 0x3F
+    dat[1] = (pressure & 0xF) << 4
+    dat[4] = 0x64
+    dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0)
+    dat[6] = 0xFF
+    dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+    return package_can_msg([0x1c3, 0, bytes(dat), self.GW_BUS])
+
+  def _heartbeat_msg(self, bus=GW_BUS, counter=0):
+    dat = bytes(b"LGW\x01\x01") + bytes([counter & 0xF, 0])
+    return package_can_msg([0x5ff, 0, dat + bytes([(0xFF + sum(dat)) & 0xFF]), bus])
+
+  def _rx_checked_msgs(self, heartbeat=True):
+    # one of each rx-checked Leaf message (addr, bus, len), zero data
+    for bus, addr, length in ((0, 0x2, 5), (0, 0x285, 8), (2, 0x30f, 3), (0, 0x239, 8), (0, 0x1cc, 4)):
+      self._rx(make_msg(bus, addr, length))
+    if heartbeat:
+      self.assertTrue(self._rx(self._heartbeat_msg()))
+
+  def test_leaf_gas_limits(self):
+    for cmd in [*range(0, 16384, 61), self.MIN_GAS - 1, self.MIN_GAS, self.INACTIVE_GAS, self.MAX_GAS, self.MAX_GAS + 1]:
+      self.safety.set_controls_allowed(1)
+      should_tx = self.MIN_GAS <= cmd <= self.MAX_GAS
+      self.assertEqual(should_tx, self._tx(self._accel_msg(cmd)), msg=f"gas={cmd}")
+      # a violation also drops controls, as every other nissan tx violation does
+      self.assertEqual(should_tx, self.safety.get_controls_allowed())
+
+  def test_leaf_brake_limits(self):
+    for p in [*range(0, 1024, 7), self.MAX_BRAKE, self.MAX_BRAKE + 1]:
+      self.safety.set_controls_allowed(1)
+      should_tx = p <= self.MAX_BRAKE
+      self.assertEqual(should_tx, self._tx(self._brake_cmd_msg(p, active=p > 0, brake_mode=p > 0)), msg=f"brake={p}")
+
+  def test_leaf_disengaged_requires_inactive(self):
+    self.safety.set_controls_allowed(0)
+    # only the inactive no-op may go out
+    self.assertTrue(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+    self.assertTrue(self._tx(self._brake_cmd_msg(0, active=False)))
+    for cmd in (self.MIN_GAS, self.INACTIVE_GAS - 1, self.INACTIVE_GAS + 1, 7000, self.MAX_GAS):
+      self.assertFalse(self._tx(self._accel_msg(cmd)), msg=f"gas={cmd}")
+    for p in (1, 200, self.MAX_BRAKE):
+      self.assertFalse(self._tx(self._brake_cmd_msg(p)), msg=f"brake={p}")
+
+  def test_leaf_gas_pressed_blocks(self):
+    # driver on the accelerator -> longitudinal not allowed even while engaged
+    # (unsafe mode keeps controls_allowed through the press so the tx gate is what's tested)
+    self.safety.set_unsafe_mode(UNSAFE_MODE.DISABLE_DISENGAGE_ON_GAS)
+    self.safety.set_controls_allowed(1)
+    self._rx(self._gas_msg(self.GAS_PRESSED_THRESHOLD + 1))
+    self.assertTrue(self.safety.get_gas_pressed_prev())
+    self.assertTrue(self.safety.get_controls_allowed())
+    self.assertTrue(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+    self.assertTrue(self._tx(self._brake_cmd_msg(0, active=False)))
+    self.assertFalse(self._tx(self._accel_msg(7000)))
+    self.safety.set_controls_allowed(1)
+    self.assertFalse(self._tx(self._brake_cmd_msg(200)))
+    # gas released -> allowed again
+    self._rx(self._gas_msg(0))
+    self.safety.set_controls_allowed(1)
+    self.assertTrue(self._tx(self._accel_msg(7000)))
+    self.assertTrue(self._tx(self._brake_cmd_msg(200)))
+
+  def test_leaf_stock_frames(self):
+    # golden stock ZE1 frames decode to the limits: idle == inactive, brake marker == min
+    self.safety.set_controls_allowed(0)
+    self.assertTrue(self._tx(package_can_msg([0x2b0, 0, bytes.fromhex("dc53a2ac1b000e03"), self.GW_BUS])))
+    self.assertFalse(self._tx(package_can_msg([0x2b0, 0, bytes.fromhex("a827d5ac5b000e09"), self.GW_BUS])))
+    self.safety.set_controls_allowed(1)
+    self.assertTrue(self._tx(package_can_msg([0x2b0, 0, bytes.fromhex("a827d5ac5b000e09"), self.GW_BUS])))
+    self.assertTrue(self._tx(package_can_msg([0x2b0, 0, bytes.fromhex("ff6090ac5b000e03"), self.GW_BUS])))  # 6144, neutral
+
+  def test_leaf_long_frames_only_on_gw_bus(self):
+    self.safety.set_controls_allowed(1)
+    for bus in (0, 1, 3):
+      self.assertFalse(self._tx(package_can_msg([0x2b0, 0, bytes.fromhex("dc53a2ac1b000e03"), bus])))
+      self.assertFalse(self._tx(make_msg(bus, 0x1c3, 8)))
+
+  def test_leaf_gateway_heartbeat_required(self):
+    # long mode monitors the heartbeat as an rx check: no gateway -> rx checks invalid
+    self._rx_checked_msgs(heartbeat=False)
+    self.assertFalse(self.safety.addr_checks_valid())
+    self._rx(self._heartbeat_msg(bus=0))  # ... only counts on the gateway bus
+    self.assertFalse(self.safety.addr_checks_valid())
+    self._rx_checked_msgs(heartbeat=True)
+    self.assertTrue(self.safety.addr_checks_valid())
+
+  def test_leaf_heartbeat_lost_drops_controls(self):
+    self._rx_checked_msgs(heartbeat=True)  # at t=0
+    for heartbeat in (True, False):
+      self.safety.set_timer(int(1.5e6) if heartbeat else int(3e6))
+      self._rx_checked_msgs(heartbeat=heartbeat)
+      self.safety.set_controls_allowed(1)
+      self.safety.safety_tick_current_rx_checks()
+      self.assertEqual(heartbeat, self.safety.get_controls_allowed())
+      self.assertEqual(heartbeat, self.safety.addr_checks_valid())
+
+  def test_leaf_long_needs_flag(self):
+    # lateral-only Leafs (and the Altima's alt-EPS flag) need no gateway and get no long TX
+    for param in (0, Panda.FLAG_NISSAN_ALT_EPS_BUS):
+      self.safety.set_safety_hooks(Panda.SAFETY_NISSAN, param)
+      self._rx_checked_msgs(heartbeat=False)
+      if param == 0:
+        self.assertTrue(self.safety.addr_checks_valid())
+      self.safety.set_controls_allowed(1)
+      self.assertFalse(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+      self.assertFalse(self._tx(self._brake_cmd_msg(0, active=False)))
+
 if __name__ == "__main__":
   unittest.main()
