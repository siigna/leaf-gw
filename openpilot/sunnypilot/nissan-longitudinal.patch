+class FollowMonitor:
+  """One-sided check that the car follows what openpilot sent through leaf-gw.
+
+  Faults when the car is slowing LESS than openpilot asked -- T sent LAG ago minus the
+  T the car is acting on (0x180) above TOL -- for WINDOW seconds: the gateway isn't
+  relaying, or the car isn't obeying. Slowing MORE than asked is fine: that's stock
+  winning the arbitration. Latches until longitudinal goes inactive. Time-based, so it
+  holds at any controller rate. On 37 stock Leafs a perfect relay never trips it
+  (p99.9 residual 61, 0 of 127 segments)."""
+  LAG = 0.16     # s
+  TOL = 60       # T counts
+  WINDOW = 1.0   # s
+
+  def __init__(self):
+    self.hist = []          # (time, T sent)
+    self.bad_since = None
+    self.fault = False
+
+  def update(self, op_t, feedback, active, evaluate, now):
+    if not active or now is None:   # no clock -> can't check; never crash the controller
+      self.hist, self.bad_since, self.fault = [], None, False
+      return False
+    self.hist.append((now, op_t))
+    while len(self.hist) > 1 and self.hist[1][0] <= now - self.LAG:
+      self.hist.pop(0)
+    t0, lagged = self.hist[0]
+    if (not evaluate or feedback is None or t0 > now - self.LAG or
+        any(t == CarControllerParams.PROPILOT_BRAKE_RAW for _, t in self.hist)):
+      self.bad_since = None
+      return self.fault
+    if lagged - feedback > self.TOL:
+      self.bad_since = now if self.bad_since is None else self.bad_since
+      if now - self.bad_since >= self.WINDOW:
+        self.fault = True
+    else:
+      self.bad_since = None
+    return self.fault
 
 
