diff --git a/opendbc/car/nissan/nissancan.py b/opendbc/car/nissan/nissancan.py
index 24a49e02..797aed10 100644
--- a/opendbc/car/nissan/nissancan.py
+++ b/opendbc/car/nissan/nissancan.py
@@ -1,6 +1,14 @@
+from opendbc.car import CanData
 from opendbc.car.crc import CRC8J1850, mk_crc8_fun
 from opendbc.car.nissan.values import CAR
 
+# Bus the leaf-gw gateway taps to read these frames (V-CAN; the comma already
+# drives it for steering). Which V-CAN segment / panda bus is a bench check.
+LEAF_LONG_BUS = 2
+# The gateway's 50 Hz heartbeat on LEAF_LONG_BUS: longitudinal is offered only when
+# the fingerprint saw it, and panda drops control if it stops.
+LEAF_GW_HEARTBEAT = 0x5FF
+
 # TODO: add this checksum to the CANPacker
 nissan_checksum = mk_crc8_fun(CRC8J1850, init_crc=0x00, xor_out=0xFF)
 
@@ -152,3 +160,35 @@ def create_lkas_hud_info_msg(packer, lkas_hud_info_msg, steer_hud_alert):
     values["HANDS_ON_WHEEL_WARNING"] = 1
 
   return packer.make_can_msg("PROPILOT_HUD_INFO_MSG", 0, values)
+
+
+def create_accel_command(command, frame, active):
+  """Leaf ADAS propulsion/regen request (0x2B0). command = T, higher = more decel.
+  leaf-gw re-stamps the counter and stock state byte and re-emits it on Chassis CAN."""
+  t = int(min(max(int(command), 0), 4095))
+  inverse = (~t) & 0xFFF
+  aux = 2 if t == 3415 else 0   # stock pairs the friction-brake marker with aux 2
+  dat = bytes([
+    inverse & 0xFF,
+    (((inverse >> 8) & 0xF) << 4) | (t & 0xF),
+    (t >> 4) & 0xFF,
+    0xAC,
+    0x5B if active else 0x1B,
+    0x00,
+    ((frame & 0xF) << 4) | 0xE,
+    (aux << 2) | ((~aux) & 0x3),
+  ])
+  return CanData(0x2B0, dat, LEAF_LONG_BUS)
+
+
+def create_brake_command(pressure, frame, active, brake_mode):
+  """Leaf ADAS friction-brake request (0x1C3), pressure in 0.5-count units."""
+  pressure = int(pressure)
+  dat = bytearray(8)
+  dat[0] = (pressure >> 4) & 0x3F
+  dat[1] = (pressure & 0xF) << 4
+  dat[4] = 0x64
+  dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0) | (frame & 0x3)
+  dat[6] = 0xFF
+  dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+  return CanData(0x1C3, bytes(dat), LEAF_LONG_BUS)
