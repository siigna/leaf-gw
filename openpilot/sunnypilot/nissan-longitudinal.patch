+  @parameterized("car_name, alpha_long", [(c, a) for c in LEAFS for a in (True, False)])
+  def test_icbm_buttons(self, car_name, alpha_long):
+    # an ICBM request must never become a spoofed SET/RES press under openpilot longitudinal
+    CI = get_interface(car_name, alpha_long)
+    CC = structs.CarControl(enabled=True, latActive=True, longActive=alpha_long)
+    CC_SP = structs.CarControlSP()
+    CC_SP.intelligentCruiseButtonManagement.sendButton = SendButtonState.increase
+    sends = [(addr, dat, bus) for addr, dat, bus in run(CI, CC, CC_SP, 50) if addr == 0x239 and bus == 2]
+    self.assertTrue(sends)
+
+    cp = CANParser("nissan_leaf_2018_generated", [("CRUISE_THROTTLE", 0)], 2)
+    res_pressed = False
+    for i, s in enumerate(sends):
+      cp.update([(int(i * 2e7), [s])])
+      res_pressed |= any(cp.vl_all["CRUISE_THROTTLE"]["RES_BUTTON"])
+    self.assertEqual(res_pressed, not alpha_long)
+
+
+def drive(car_name, car_t, accel, frames=200, dt=DT_CTRL):
+  """Run the real interface at 10 m/s: openpilot asks for `accel`, the car reports
+  (via 0x180) acting on T `car_t`. Returns accFaulted per frame."""
+  CI = get_interface(car_name, True)
+  packer = CANPacker("nissan_leaf_2018_generated")
+  CC = structs.CarControl(enabled=True, latActive=True, longActive=True)
+  CC.actuators.accel = accel
+  CC = CC.as_reader()
+  d = round(-0.796 * car_t + 2067.1)
+  now, faults = 0, []
+  for _ in range(frames):
+    msgs = [packer.make_can_msg("WHEEL_SPEEDS_REAR", 0, {"WHEEL_SPEED_RR": 36, "WHEEL_SPEED_RL": 36}),   # 36 km/h
+            packer.make_can_msg("WHEEL_SPEEDS_FRONT", 0, {"WHEEL_SPEED_FR": 36, "WHEEL_SPEED_FL": 36}),
+            packer.make_can_msg("PROPULSION_FEEDBACK", feedback_bus(car_name), {"D": d})]
+    out, _ = CI.update([(now, msgs)])
+    faults.append(out.accFaulted)
+    CI.apply(CC, structs.CarControlSP(), now)
+    now += int(dt * 1e9)
+  return faults
+
+
+class TestNissanLeafFollowCheck(unittest.TestCase):
+
+  @parameterized("car_name", LEAFS)
+  def test_faults_when_car_slows_less_than_asked(self, car_name):
+    # openpilot asks for -0.5 m/s^2 (T ~2730) but the car acts on T 2528 (~0): not relaying
+    faults = drive(car_name, car_t=2528, accel=-0.5)
+    self.assertFalse(any(faults[:110]))
+    self.assertTrue(all(faults[130:]))
+
+  @parameterized("car_name", LEAFS)
+  def test_quiet_when_car_follows_or_slows_more(self, car_name):
+    self.assertFalse(any(drive(car_name, car_t=2730, accel=-0.5)))   # follows
+    self.assertFalse(any(drive(car_name, car_t=2784, accel=0.0)))    # slows more than asked: stock winning
+
+  def test_no_clock_never_crashes(self):
+    # a missing timestamp must not raise in the controller, and can't fault
+    self.assertFalse(FollowMonitor().update(2730, 2528.0, True, True, None))
+
+  @parameterized("car_name, dt", [(c, dt) for c in LEAFS for dt in (0.01, 0.02)])
+  def test_timing_is_rate_independent(self, car_name, dt):
+    # same ~1.16 s to fault whether the controller runs at 100 Hz or 50 Hz
+    faults = drive(car_name, car_t=2528, accel=-0.5, frames=round(2.0 / dt), dt=dt)
+    self.assertIn(True, faults)
+    self.assertTrue(1.1 <= faults.index(True) * dt <= 1.3, (dt, faults.index(True) * dt))
+
+
+if __name__ == "__main__":
+  unittest.main()
