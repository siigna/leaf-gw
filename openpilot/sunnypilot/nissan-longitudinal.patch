diff --git a/opendbc/sunnypilot/car/nissan/test_nissan.py b/opendbc/sunnypilot/car/nissan/test_nissan.py
new file mode 100644
index 00000000..28b81e01
--- /dev/null
+++ b/opendbc/sunnypilot/car/nissan/test_nissan.py
@@ -0,0 +1,129 @@
+"""
+Copyright (c) 2021-, Haibin Wen, sunnypilot, and a number of other contributors.
+
+This file is part of sunnypilot and is licensed under the MIT License.
+See the LICENSE.md file in the root directory for more details.
+"""
+import unittest
+
+from opendbc.testing import parameterized
+
+from opendbc.can import CANParser
+
+from opendbc.car import gen_empty_fingerprint, structs
+from opendbc.car.car_helpers import interfaces
+from opendbc.car.nissan.nissancan import LEAF_GW_HEARTBEAT, LEAF_LONG_BUS, create_accel_command
+from opendbc.car.nissan.values import CAR, CarControllerParams, NissanSafetyFlags
+from opendbc.sunnypilot.car.nissan.values import NissanSafetyFlagsSP
+
+SendButtonState = structs.IntelligentCruiseButtonManagement.SendButtonState
+LEAFS = (CAR.NISSAN_LEAF, CAR.NISSAN_LEAF_IC)
+
+
+def get_interface(car_name, alpha_long, heartbeat_bus=LEAF_LONG_BUS):
+  fingerprint = gen_empty_fingerprint()
+  if heartbeat_bus is not None:
+    fingerprint[heartbeat_bus][LEAF_GW_HEARTBEAT] = 8
+  CarInterface = interfaces[car_name]
+  CP = CarInterface.get_params(car_name, fingerprint, [], alpha_long, False, False)
+  CP_SP = CarInterface.get_params_sp(CP, car_name, fingerprint, [], alpha_long, False, False)
+  return CarInterface(CP, CP_SP)
+
+
+def run(CI, CC, CC_SP, frames, cruise_enabled=True):
+  CC = CC.as_reader()
+  sends = []
+  for i in range(frames):
+    CI.update([])
+    CI.CS.out.cruiseState.enabled = cruise_enabled
+    _, can = CI.apply(CC, CC_SP, int(i * 1e7))
+    sends += can
+  return sends
+
+
+class TestNissanLeafLongitudinal(unittest.TestCase):
+
+  @parameterized("car_name, alpha_long", [(c, a) for c in CAR for a in (True, False)])
+  def test_params(self, car_name, alpha_long):
+    CI = get_interface(car_name, alpha_long)
+    CP, CP_SP = CI.CP, CI.CP_SP
+    is_leaf = car_name in LEAFS
+    long = is_leaf and alpha_long
+
+    self.assertEqual(CP.alphaLongitudinalAvailable, is_leaf)
+    self.assertEqual(CP.openpilotLongitudinalControl, long)
+    # stock ICC engagement gates openpilot longitudinal too
+    self.assertTrue(CP.pcmCruise)
+    self.assertFalse(CP.autoResumeSng)
+    self.assertEqual(bool(CP.safetyConfigs[0].safetyParam & NissanSafetyFlags.LONG_CONTROL), long)
+    self.assertEqual(bool(CP_SP.safetyParam & NissanSafetyFlagsSP.LEAF), is_leaf)
+    # ICBM spoofs cruise buttons: off with openpilot longitudinal, unchanged otherwise
+    self.assertEqual(CP_SP.intelligentCruiseButtonManagementAvailable, car_name != CAR.NISSAN_ALTIMA and not long)
+
+  @parameterized("car_name, heartbeat_bus", [(c, b) for c in LEAFS for b in (None, 0, 1)])
+  def test_long_needs_gateway_heartbeat(self, car_name, heartbeat_bus):
+    # heartbeat absent, or on the wrong bus: no longitudinal, no LONG flag, ICBM stays available
+    CI = get_interface(car_name, True, heartbeat_bus)
+    self.assertFalse(CI.CP.alphaLongitudinalAvailable)
+    self.assertFalse(CI.CP.openpilotLongitudinalControl)
+    self.assertFalse(CI.CP.safetyConfigs[0].safetyParam & NissanSafetyFlags.LONG_CONTROL)
+    self.assertTrue(CI.CP_SP.intelligentCruiseButtonManagementAvailable)
+
+  def test_accel_frames_match_stock(self):
+    # stock ZE1 frames (public route): idle, friction-brake marker, neutral
+    self.assertEqual(create_accel_command(CarControllerParams.PROPILOT_INACTIVE_RAW, 0, False).dat.hex(), "dc53a2ac1b000e03")
+    self.assertEqual(create_accel_command(CarControllerParams.PROPILOT_BRAKE_RAW, 0, True).dat.hex(), "a827d5ac5b000e09")
+    self.assertEqual(create_accel_command(2304, 0, True).dat.hex(), "ff6090ac5b000e03")
+
+  @parameterized("car_name", LEAFS)
+  def test_long_frames(self, car_name):
+    CI = get_interface(car_name, True)
+    CC = structs.CarControl(enabled=True, latActive=True, longActive=True)
+    CC.actuators.accel = 0.0
+    sends = run(CI, CC, structs.CarControlSP(), 1)
+    by_addr = {(addr, bus): dat for addr, dat, bus in sends}
+    # golden bytes from leaf_gw_long: accel 0 -> T 2528, no friction brake
+    self.assertEqual(by_addr[(0x2b0, 2)].hex(), "1f609eac5b000e03")
+    self.assertEqual(by_addr[(0x1c3, 2)].hex(), "000000006400ff27")
+
+    # below PROPILOT_ACCEL_MIN: stock friction-brake marker + pressure 322 (frame 0 again: fresh interface)
+    CI = get_interface(car_name, True)
+    CC.actuators.accel = -2.0
+    sends = run(CI, CC, structs.CarControlSP(), 1)
+    by_addr = {(addr, bus): dat for addr, dat, bus in sends}
+    self.assertEqual(by_addr[(0x2b0, 2)].hex(), "a827d5ac5b000e09")
+    self.assertEqual(by_addr[(0x1c3, 2)].hex(), "142000006484ffdf")
+
+    CC.longActive = False
+    sends = run(CI, CC, structs.CarControlSP(), 1)
+    by_addr = {(addr, bus): dat for addr, dat, bus in sends}
+    # disengaged: the stock idle frame (counter nibble aside)
+    self.assertEqual(by_addr[(0x2b0, 2)].hex(), "dc53a2ac1b001e03")
+
+  @parameterized("car_name, alpha_long", [(c, a) for c in LEAFS for a in (True, False)])
+  def test_no_long_frames_without_long(self, car_name, alpha_long):
+    CI = get_interface(car_name, alpha_long)
+    CC = structs.CarControl(enabled=True, latActive=True, longActive=alpha_long)
+    addrs = {addr for addr, _, _ in run(CI, CC, structs.CarControlSP(), 4)}
+    self.assertEqual({0x2b0, 0x1c3} & addrs, {0x2b0, 0x1c3} if alpha_long else set())
+
+  @parameterized("car_name, alpha_long", [(c, a) for c in LEAFS for a in (True, False)])
+  def test_icbm_buttons(self, car_name, alpha_long):
+    # an ICBM request must never become a spoofed SET/RES press under openpilot longitudinal
+    CI = get_interface(car_name, alpha_long)
+    CC = structs.CarControl(enabled=True, latActive=True, longActive=alpha_long)
+    CC_SP = structs.CarControlSP()
+    CC_SP.intelligentCruiseButtonManagement.sendButton = SendButtonState.increase
+    sends = [(addr, dat, bus) for addr, dat, bus in run(CI, CC, CC_SP, 50) if addr == 0x239 and bus == 2]
+    self.assertTrue(sends)
+
+    cp = CANParser("nissan_leaf_2018_generated", [("CRUISE_THROTTLE", 0)], 2)
+    res_pressed = False
+    for i, s in enumerate(sends):
+      cp.update([(int(i * 2e7), [s])])
+      res_pressed |= any(cp.vl_all["CRUISE_THROTTLE"]["RES_BUTTON"])
+    self.assertEqual(res_pressed, not alpha_long)
+
+
+if __name__ == "__main__":
+  unittest.main()
