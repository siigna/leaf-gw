+
+class TestNissanLeafLongSafety(TestNissanLeafSafety):
+  """Leaf longitudinal via the leaf-gw gateway. openpilot TXes the real
+  0x2B0 / 0x1C3 on the control bus (V-CAN); panda bounds them with the shared
+  longitudinal helpers and gates on controls_allowed + gas-not-pressed."""
+
+  TX_MSGS = [[0x169, 0], [0x2b1, 0], [0x4cc, 0], [0x239, 2], [0x2b0, 2], [0x1c3, 2]]
+
+  # mirrors CarControllerParams / modes/nissan.h NISSAN_LONG_LIMITS
+  GW_BUS = 2
+  MAX_GAS = 8191
+  MIN_GAS = 2398
+  INACTIVE_GAS = 5260
+  MAX_BRAKE = 659
+
+  def setUp(self):
+    self.packer = CANPackerSafety("nissan_leaf_2018_generated")
+    self.safety = libsafety_py.libsafety
+    self.safety.set_current_safety_param_sp(NissanSafetyFlagsSP.LEAF)
+    self.safety.set_safety_hooks(CarParams.SafetyModel.nissan, NissanSafetyFlags.LONG_CONTROL)
+    self.safety.init_tests()
+
+  def _accel_msg(self, raw_command, active=True):
+    raw_command = int(raw_command)
+    raw12, fraction = divmod(raw_command, 4)
+    inverse = (~raw12) & 0xFFF
+    dat = bytes([
+      inverse & 0xFF,
+      (((raw12 >> 8) & 0xF) << 4) | (raw12 & 0xF),
+      (((inverse >> 8) & 0xF) << 4) | ((raw12 >> 4) & 0xF),
+      0xAC, 0x5B if active else 0x1B, 0x00, 0x0E,
+      (fraction << 2) | ((~fraction) & 0x3),
+    ])
+    return make_msg(self.GW_BUS, 0x2b0, 8, dat)
+
+  def _brake_msg(self, pressure, active=True, brake_mode=False):
+    pressure = int(pressure)
+    dat = bytearray(8)
+    dat[0] = (pressure >> 4) & 0x3F
+    dat[1] = (pressure & 0xF) << 4
+    dat[4] = 0x64
+    dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0)
+    dat[6] = 0xFF
+    dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+    return make_msg(self.GW_BUS, 0x1c3, 8, bytes(dat))
+
+  def test_leaf_gas_limits(self):
+    self.safety.set_controls_allowed(True)
+    for cmd in range(0, 8192, 64):
+      should_tx = self.MIN_GAS <= cmd <= self.MAX_GAS
+      self.assertEqual(should_tx, self._tx(self._accel_msg(cmd)), msg=f"gas={cmd}")
+
+  def test_leaf_brake_limits(self):
+    self.safety.set_controls_allowed(True)
+    for p in range(0, 1024, 16):
+      should_tx = p <= self.MAX_BRAKE
+      self.assertEqual(should_tx, self._tx(self._brake_msg(p, active=p > 0, brake_mode=p > 0)), msg=f"brake={p}")
+
+  def test_leaf_disengaged_requires_inactive(self):
+    self.safety.set_controls_allowed(False)
+    # only the inactive no-op may go out
+    self.assertTrue(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+    self.assertTrue(self._tx(self._brake_msg(0, active=False)))
+    self.assertFalse(self._tx(self._accel_msg(7000)))
+    self.assertFalse(self._tx(self._accel_msg(self.MIN_GAS)))
+    self.assertFalse(self._tx(self._brake_msg(200)))
+
+  def test_leaf_gas_pressed_blocks(self):
+    # driver on the accelerator -> longitudinal not allowed even if engaged
+    self.safety.set_controls_allowed(True)
+    self.safety.set_gas_pressed_prev(True)
+    self.assertFalse(self._tx(self._accel_msg(7000)))
+    self.assertTrue(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+
+  def _heartbeat_msg(self, counter=0):
+    dat = bytearray(b"LGW\x01\x01") + bytes([counter & 0xF, 0])
+    return make_msg(self.GW_BUS, 0x5ff, 8, bytes(dat) + bytes([(0xFF + sum(dat)) & 0xFF]))
+
+  def test_leaf_stock_frames(self):
+    # golden stock ZE1 frames decode to the limits: idle == inactive, brake marker == min
+    self.safety.set_controls_allowed(False)
+    self.assertTrue(self._tx(make_msg(self.GW_BUS, 0x2b0, 8, bytes.fromhex("dc53a2ac1b000e03"))))
+    self.safety.set_controls_allowed(True)
+    self.assertTrue(self._tx(make_msg(self.GW_BUS, 0x2b0, 8, bytes.fromhex("a827d5ac5b000e09"))))
+
+  def _rx_seen(self):
+    return [self.safety.get_rx_check_msg_seen(i) for i in range(self.safety.get_rx_checks_len())]
+
+  def _hooks(self, param_sp, param):
+    self.safety.set_current_safety_param_sp(param_sp)
+    self.safety.set_safety_hooks(CarParams.SafetyModel.nissan, param)
+
+  def test_leaf_gateway_heartbeat_required(self):
+    # long mode monitors the heartbeat as an rx check: if it stops, panda's rx checks
+    # go invalid and controls_allowed drops, so no gateway -> no longitudinal
+    before = self._rx_seen()
+    self.assertTrue(self._rx(self._heartbeat_msg()))
+    self.assertEqual(sum(self._rx_seen()) - sum(before), 1)
+    # ... only on the gateway bus
+    self._hooks(NissanSafetyFlagsSP.LEAF, NissanSafetyFlags.LONG_CONTROL)
+    self._rx(make_msg(0, 0x5ff, 8, bytes(8)))
+    self.assertEqual(sum(self._rx_seen()), 0)
+    # ... and not at all without the LONG flag (lateral-only Leafs need no gateway)
+    self._hooks(NissanSafetyFlagsSP.LEAF, 0)
+    self._rx(self._heartbeat_msg())
+    self.assertEqual(sum(self._rx_seen()), 0)
+
+  def test_long_flag_needs_leaf(self):
+    # LONG_CONTROL without the sunnypilot LEAF flag must not open 0x2B0/0x1C3
+    self.safety.set_current_safety_param_sp(NissanSafetyFlagsSP.DEFAULT)
+    self.safety.set_safety_hooks(CarParams.SafetyModel.nissan, NissanSafetyFlags.LONG_CONTROL)
+    self.safety.init_tests()
+    self.safety.set_controls_allowed(True)
+    self.assertFalse(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+    self.assertFalse(self._tx(self._brake_msg(0, active=False)))
+
+
 if __name__ == "__main__":
   unittest.main()
