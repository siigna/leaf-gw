+// leaf-gw longitudinal: openpilot sends the real 0x2B0 (propulsion/regen) and
+// 0x1C3 (friction brake) on the gateway's control bus (V-CAN). Bound them with
+// the shared longitudinal helpers; the gateway re-emits onto Chassis CAN and keeps
+// stock AEB by magnitude arbitration.
+#define NISSAN_GW_BUS 2
+static const LongitudinalLimits NISSAN_LONG_LIMITS = {
+  .max_gas = 8191,       // 0x2B0 raw command ceiling (12-bit)
+  .min_gas = 2398,       // PROPILOT_BRAKE_RAW (stock friction-brake marker)
+  .inactive_gas = 5260,  // PROPILOT_INACTIVE_RAW (stock idle frame)
+  .max_brake = 659,      // 0x1C3 pressure ceiling (0.5-count units)
+};
+
 static bool nissan_tx_hook(const CANPacket_t *msg) {
   bool tx = true;
   bool violation = false;
@@ -103,6 +115,24 @@ static bool nissan_tx_hook(const CANPacket_t *msg) {
     }
   }
 
+  // leaf-gw propulsion/regen request (0x2B0); only in the TX list with the LONG flag
+  if (msg->addr == 0x2b0U) {
+    // 12-bit value: data[1] = V_hi:V_lo, data[2] low nibble = V_mid
+    int raw12 = ((msg->data[1] >> 4) << 8) | ((msg->data[2] & 0x0FU) << 4) | (msg->data[1] & 0x0FU);
+    int command = (raw12 << 2) | ((msg->data[7] >> 2) & 0x03U);
+    if (longitudinal_gas_checks(command, NISSAN_LONG_LIMITS)) {
+      violation = true;
+    }
+  }
+
+  // leaf-gw friction-brake request (0x1C3)
+  if (msg->addr == 0x1c3U) {
+    int pressure = ((msg->data[0] & 0x3FU) << 4) | (msg->data[1] >> 4);
+    if (longitudinal_brake_checks(pressure, NISSAN_LONG_LIMITS)) {
+      violation = true;
+    }
+  }
+
   if (violation) {
     tx = false;
   }
