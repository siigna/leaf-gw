+  def _accel_msg(self, raw_command, active=True):
+    raw_command = int(raw_command)
+    raw12, fraction = divmod(raw_command, 4)
+    inverse = (~raw12) & 0xFFF
+    dat = bytes([
+      inverse & 0xFF,
+      (((raw12 >> 8) & 0xF) << 4) | (raw12 & 0xF),
+      (((inverse >> 8) & 0xF) << 4) | ((raw12 >> 4) & 0xF),
+      0xAC, 0x5B if active else 0x1B, 0x00, 0x0E,
+      (fraction << 2) | ((~fraction) & 0x3),
+    ])
+    return make_msg(self.GW_BUS, 0x2b0, 8, dat)
+
+  def _brake_msg(self, pressure, active=True, brake_mode=False):
+    pressure = int(pressure)
+    dat = bytearray(8)
+    dat[0] = (pressure >> 4) & 0x3F
+    dat[1] = (pressure & 0xF) << 4
+    dat[4] = 0x64
+    dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0)
+    dat[6] = 0xFF
+    dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+    return make_msg(self.GW_BUS, 0x1c3, 8, bytes(dat))
+
