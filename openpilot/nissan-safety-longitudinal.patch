+  // leaf-gw propulsion/regen request (0x2B0)
+  if (msg->addr == 0x2b0U) {
+    // 12-bit value: data[1] = V_hi:V_lo, data[2] low nibble = V_mid
+    int raw12 = ((msg->data[1] >> 4) << 8) | ((msg->data[2] & 0x0FU) << 4) | (msg->data[1] & 0x0FU);
+    int command = (raw12 << 2) | ((msg->data[7] >> 2) & 0x03U);
+    if (longitudinal_gas_checks(command, NISSAN_LONG_LIMITS)) {
+      violation = true;
+    }
+  }
