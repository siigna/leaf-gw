+bool nissan_leaf_long = false;
 
 static int nissan_rx_hook(CANPacket_t *to_push) {
 
@@ -100,14 +145,37 @@ static int nissan_rx_hook(CANPacket_t *to_push) {
 
 
 static int nissan_tx_hook(CANPacket_t *to_send, bool longitudinal_allowed) {
-  UNUSED(longitudinal_allowed);
-
   int tx = 1;
   int addr = GET_ADDR(to_send);
   bool violation = 0;
 
-  if (!msg_allowed(to_send, NISSAN_TX_MSGS, sizeof(NISSAN_TX_MSGS) / sizeof(NISSAN_TX_MSGS[0]))) {
-    tx = 0;
+  if (nissan_leaf_long) {
+    if (!msg_allowed(to_send, NISSAN_LEAF_LONG_TX_MSGS, sizeof(NISSAN_LEAF_LONG_TX_MSGS) / sizeof(NISSAN_LEAF_LONG_TX_MSGS[0]))) {
+      tx = 0;
+    }
+  } else {
+    if (!msg_allowed(to_send, NISSAN_TX_MSGS, sizeof(NISSAN_TX_MSGS) / sizeof(NISSAN_TX_MSGS[0]))) {
+      tx = 0;
+    }
+  }
+
+  // leaf-gw propulsion/regen request (0x2B0): a bounded command while longitudinal
+  // is allowed (engaged, gas not pressed), otherwise only the stock idle value
+  if (addr == 0x2b0) {
+    // T = byte 2 << 4 | byte 1 low nibble (inverted copy in byte 1 high nibble + byte 0)
+    int command = (GET_BYTE(to_send, 2) << 4) | (GET_BYTE(to_send, 1) & 0xFU);
+    bool command_valid = longitudinal_allowed && (command >= NISSAN_LEAF_MIN_GAS) && (command <= NISSAN_LEAF_MAX_GAS);
+    if (!command_valid && (command != NISSAN_LEAF_INACTIVE_GAS)) {
+      violation = 1;
+    }
+  }
+
+  // leaf-gw friction-brake request (0x1C3): bounded, and zero unless longitudinal is allowed
+  if (addr == 0x1c3) {
+    int pressure = ((GET_BYTE(to_send, 0) & 0x3FU) << 4) | (GET_BYTE(to_send, 1) >> 4);
+    if ((pressure > NISSAN_LEAF_MAX_BRAKE) || (!longitudinal_allowed && (pressure != 0))) {
+      violation = 1;
+    }
   }
 
   // steer cmd checks
@@ -183,7 +251,13 @@ static int nissan_fwd_hook(int bus_num, CANPacket_t *to_fwd) {
 }
 
 static const addr_checks* nissan_init(uint16_t param) {
-  nissan_alt_eps = param ? 1 : 0;
+  nissan_alt_eps = GET_FLAG(param, NISSAN_PARAM_ALT_EPS_BUS);
+  nissan_leaf_long = GET_FLAG(param, NISSAN_PARAM_LEAF_LONG);
+  if (nissan_leaf_long) {
+    nissan_rx_checks = (addr_checks){nissan_leaf_long_addr_checks, NISSAN_LEAF_LONG_ADDR_CHECK_LEN};
+  } else {
+    nissan_rx_checks = (addr_checks){nissan_addr_checks, NISSAN_ADDR_CHECK_LEN};
+  }
   return &nissan_rx_checks;
 }
 
