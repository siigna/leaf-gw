@@ -70,3 +78,36 @@ def create_lkas_hud_info_msg(packer, lkas_hud_info_msg, steer_hud_alert):
     values["HANDS_ON_WHEEL_WARNING"] = 1
 
   return packer.make_can_msg("PROPILOT_HUD_INFO_MSG", 0, values)
