+
+def create_accel_command(raw_command, frame, active):
+  """Leaf ADAS propulsion/regen request (0x2B0). leaf-gw re-stamps the counter
+  and re-emits it on Chassis CAN; openpilot only owns the command value."""
+  raw_command = int(raw_command)
+  # value nibbles: dat[1] = V_hi:V_lo, dat[2] = I_hi:V_mid, dat[0] = I, with I = ~V
+  raw12, fraction = divmod(raw_command, 4)
+  inverse = (~raw12) & 0xFFF
+  dat = bytes([
+    inverse & 0xFF,
+    (((raw12 >> 8) & 0xF) << 4) | (raw12 & 0xF),
+    (((inverse >> 8) & 0xF) << 4) | ((raw12 >> 4) & 0xF),
+    0xAC,
+    0x5B if active else 0x1B,
+    0x00,
+    ((frame & 0xF) << 4) | 0xE,
+    (fraction << 2) | ((~fraction) & 0x3),
+  ])
+  return make_can_msg(0x2B0, dat, LEAF_LONG_BUS)
+
+
+def create_brake_command(pressure, frame, active, brake_mode):
+  """Leaf ADAS friction-brake request (0x1C3), pressure in 0.5-count units."""
+  pressure = int(pressure)
+  dat = bytearray(8)
+  dat[0] = (pressure >> 4) & 0x3F
+  dat[1] = (pressure & 0xF) << 4
+  dat[4] = 0x64
+  dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0) | (frame & 0x3)
+  dat[6] = 0xFF
+  dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+  return make_can_msg(0x1C3, bytes(dat), LEAF_LONG_BUS)
