@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+# Leaf longitudinal via the inline leaf-gw Chassis CAN gateway (github.com/siigna/leaf-gw).
+import unittest
+from unittest import mock
+
+from cereal import car
+from opendbc.can.packer import CANPacker
+from panda import Panda
+from selfdrive.car import gen_empty_fingerprint
+from selfdrive.car.nissan import carcontroller
+from selfdrive.car.nissan.carcontroller import CarController
+from selfdrive.car.nissan.carstate import CarState
+from selfdrive.car.nissan.interface import CarInterface
+from selfdrive.boardd.boardd import can_list_to_can_capnp
+from selfdrive.car.nissan.nissancan import LEAF_FEEDBACK_ADDR, LEAF_GW_HEARTBEAT, LEAF_LONG_BUS, create_accel_command, create_brake_command
+from selfdrive.car.nissan.values import CAR, CarControllerParams
+
+LongCtrlState = car.CarControl.Actuators.LongControlState
+LEAFS = (CAR.LEAF, CAR.LEAF_IC)
+
+
+def _fp(gateway=True, bus=LEAF_LONG_BUS, feedback=True, car_name=CAR.LEAF):
+  fp = gen_empty_fingerprint()
+  if gateway:
+    fp[bus][LEAF_GW_HEARTBEAT] = 8
+  if feedback:
+    fp[0 if car_name == CAR.LEAF else 1][LEAF_FEEDBACK_ADDR] = 8
+  return fp
+
+
+def _get_params(car_name, fp, experimental_long):
+  return CarInterface.get_params(car_name, fp, [], experimental_long, False)
+
+
+def _decode_accel(dat):
+  # mirrors safety_nissan.h and the gateway: T = b2<<4 | b1_lo, inverted copy in b1_hi:b0
+  t = (dat[2] << 4) | (dat[1] & 0xF)
+  assert ((dat[1] >> 4) << 8) | dat[0] == (~t) & 0xFFF
+  aux = (dat[7] >> 2) & 0x3
+  assert dat[7] & 0x3 == (~aux) & 0x3 and aux == (2 if t == CarControllerParams.PROPILOT_BRAKE_RAW else 0)
+  return t
+
+
+def _pressure(dat):
+  return ((dat[0] & 0x3F) << 4) | (dat[1] >> 4)
+
+
+class TestLeafGatewayLongitudinal(unittest.TestCase):
+  def test_long_keeps_pcm_cruise(self):
+    # openpilot cancels stock cruise when pcmCruise is False, and panda only allows
+    # control while stock cruise is engaged -- so gateway long must keep pcmCruise
+    for car_name in LEAFS:
+      CP = _get_params(car_name, _fp(car_name=car_name), True)
+      self.assertTrue(CP.experimentalLongitudinalAvailable)
+      self.assertTrue(CP.openpilotLongitudinalControl)
+      self.assertTrue(CP.pcmCruise)
+      self.assertFalse(CP.autoResumeSng)
+      self.assertEqual(CP.safetyConfigs[0].safetyParam, Panda.FLAG_NISSAN_LEAF_LONG)
+
+  def test_long_off_without_experimental_toggle(self):
+    for car_name in LEAFS:
+      CP = _get_params(car_name, _fp(car_name=car_name), False)
+      self.assertTrue(CP.experimentalLongitudinalAvailable)
+      self.assertFalse(CP.openpilotLongitudinalControl)
+      self.assertEqual(CP.safetyConfigs[0].safetyParam, 0)
+
+  def test_long_needs_gateway_heartbeat(self):
+    for fp in (_fp(gateway=False), _fp(bus=0), _fp(bus=1)):
+      CP = _get_params(CAR.LEAF, fp, True)
+      self.assertFalse(CP.experimentalLongitudinalAvailable)
+      self.assertFalse(CP.openpilotLongitudinalControl)
+      self.assertEqual(CP.safetyConfigs[0].safetyParam, 0)
+
+  def test_long_needs_feedback_frame(self):
+    # 0x180 must be on the harness's bus (0 for Nissan A, 1 for IC), or long isn't offered
+    for car_name, fp in ((CAR.LEAF, _fp(feedback=False)), (CAR.LEAF_IC, _fp(car_name=CAR.LEAF))):
+      CP = _get_params(car_name, fp, True)
+      self.assertFalse(CP.experimentalLongitudinalAvailable)
+      self.assertFalse(CP.openpilotLongitudinalControl)
+
+  def test_other_nissans_unaffected(self):
+    for car_name, param in ((CAR.ROGUE, 0), (CAR.XTRAIL, 0), (CAR.ALTIMA, Panda.FLAG_NISSAN_ALT_EPS_BUS)):
+      CP = _get_params(car_name, _fp(), True)
+      self.assertFalse(CP.experimentalLongitudinalAvailable)
+      self.assertFalse(CP.openpilotLongitudinalControl)
+      self.assertEqual(CP.safetyConfigs[0].safetyParam, param)
+
+  def test_accel_frames_match_stock(self):
+    # stock ZE1 frames (public route): idle, friction-brake marker, neutral
+    self.assertEqual(create_accel_command(CarControllerParams.PROPILOT_INACTIVE_RAW, 0, False)[2].hex(), "dc53a2ac1b000e03")
+    self.assertEqual(create_accel_command(CarControllerParams.PROPILOT_BRAKE_RAW, 0, True)[2].hex(), "a827d5ac5b000e09")
+    self.assertEqual(create_accel_command(2304, 0, True)[2].hex(), "ff6090ac5b000e03")
+    for cmd in range(0, 4096):
+      self.assertEqual(_decode_accel(create_accel_command(cmd, cmd, True)[2]), cmd)
+    self.assertEqual(_decode_accel(create_accel_command(5000, 0, True)[2]), 4095)  # clipped to 12 bits
+
+  def test_brake_frame(self):
+    for p in range(0, 1024):
+      addr, _, dat, bus = create_brake_command(p, p, True, True)
+      self.assertEqual((addr, bus), (0x1C3, LEAF_LONG_BUS))
+      self.assertEqual(_pressure(dat), p)
+      self.assertEqual(dat[7], (0x01 + 0xC3 + sum(dat[:7])) & 0xFF)
+
+  def test_packers_match_spec(self):
+    # byte-identical to leaf-gw's dependency-free spec when it is copied in (check-forks.sh does)
+    try:
+      from selfdrive.car.nissan import leaf_gw_long as spec
+    except ImportError:
+      raise unittest.SkipTest("leaf_gw_long.py not copied into selfdrive/car/nissan")
+    for frame in range(16):
+      for active in (False, True):
+        for cmd in range(-8, 4200):
+          self.assertEqual(create_accel_command(cmd, frame, active)[2], spec.pack_accel(cmd, frame, active))
+        for p in range(0, 1024, 5):
+          for brake_mode in (False, True):
+            self.assertEqual(create_brake_command(p, frame, active, brake_mode)[2], spec.pack_brake(p, frame, active, brake_mode))
+
+  def test_heartbeat_dbc(self):
+    # LEAF_GW_HEARTBEAT in the Leaf DBC lays out the gateway's bytes: 'LGW' version status counter 0 checksum
+    dat = bytes(b"LGW\x01\x03") + bytes([5, 0])
+    dat += bytes([(0xFF + sum(dat)) & 0xFF])
+    values = {"MAGIC": 0x4C4757, "VERSION": 1, "INLINE": 1, "OP_ACTIVE": 1, "COUNTER": 5, "CHECKSUM": dat[7]}
+    addr, _, packed, bus = CANPacker("nissan_leaf_2018").make_can_msg("LEAF_GW_HEARTBEAT", LEAF_LONG_BUS, values)
+    self.assertEqual((addr, bus), (LEAF_GW_HEARTBEAT, LEAF_LONG_BUS))
+    self.assertEqual(packed, dat)
+
+  def _run_controller(self, experimental_long, accel, long_active=True, stopping=False, v_ego=10., frames=5):
+    CP = _get_params(CAR.LEAF, _fp(), experimental_long)
+    CI = CarInterface(CP, CarController, CarState)
+    CC = car.CarControl.new_message()
+    CC.enabled = CC.latActive = True
+    CC.longActive = long_active
+    CC.actuators.accel = accel
+    CC.actuators.longControlState = LongCtrlState.stopping if stopping else LongCtrlState.pid
+    CI.update(CC, [])
+    CI.CS.out = CI.CS.out.as_builder()
+    CI.CS.out.vEgo = v_ego
+    sent = []
+    for _ in range(frames):
+      actuators, can_sends = CI.apply(CC, None, 0)  # controlsd: CI.apply(CC, sm, now_nanos)
+      sent += can_sends
+    return actuators, {(m[0], m[3]): m[2] for m in sent}
+
+  def test_controller_emits_frames(self):
+    # engaged, gentle decel: regen only (T on the accel->T curve), no friction brake
+    for accel, t in ((-0.5, 2730), (-0.45, 2720), (0.0, 2528), (0.79, 2272), (2.0, 2272)):
+      _, sent = self._run_controller(True, accel)
+      self.assertEqual(_decode_accel(sent[(0x2B0, LEAF_LONG_BUS)]), t, msg=f"{accel=}")
+      self.assertEqual(_pressure(sent[(0x1C3, LEAF_LONG_BUS)]), 0)
+    # higher T = more decel
+    _, a = self._run_controller(True, -0.3)
+    _, b = self._run_controller(True, 0.3)
+    self.assertGreater(_decode_accel(a[(0x2B0, LEAF_LONG_BUS)]), _decode_accel(b[(0x2B0, LEAF_LONG_BUS)]))
+    # hard decel: brake marker + friction pressure
+    _, sent = self._run_controller(True, -2.5)
+    self.assertEqual(_decode_accel(sent[(0x2B0, LEAF_LONG_BUS)]), CarControllerParams.PROPILOT_BRAKE_RAW)
+    self.assertEqual(_pressure(sent[(0x1C3, LEAF_LONG_BUS)]),
+                     round((CarControllerParams.PROPILOT_ACCEL_MIN + 2.5) * CarControllerParams.BRAKE_GAIN))
+    # stopped and holding: full hold pressure
+    _, sent = self._run_controller(True, -0.2, stopping=True, v_ego=0.)
+    self.assertEqual(_pressure(sent[(0x1C3, LEAF_LONG_BUS)]), CarControllerParams.BRAKE_MAX)
+    # not long active: only the inactive no-op frames (what panda allows when disengaged)
+    _, sent = self._run_controller(True, -2.5, long_active=False)
+    self.assertEqual(_decode_accel(sent[(0x2B0, LEAF_LONG_BUS)]), CarControllerParams.PROPILOT_INACTIVE_RAW)
+    self.assertEqual(_pressure(sent[(0x1C3, LEAF_LONG_BUS)]), 0)
+
+  def test_controller_matches_spec(self):
+    # the accel -> (T, pressure) mapping is leaf-gw's gateway_longitudinal
+    try:
+      from selfdrive.car.nissan import leaf_gw_long as spec
+    except ImportError:
+      raise unittest.SkipTest("leaf_gw_long.py not copied into selfdrive/car/nissan")
+    for accel in (-4.0, -2.5, -1.0, -0.78, -0.6, -0.3, -0.07, 0.0, 0.02, 0.3, 0.7, 0.79, 1.5):
+      for stopping, v_ego in ((False, 10.), (True, 0.)):
+        _, sent = self._run_controller(True, accel, stopping=stopping, v_ego=v_ego, frames=1)
+        t, pressure, _, _ = spec.gateway_longitudinal(accel, True, stopping, v_ego)
+        self.assertEqual((_decode_accel(sent[(0x2B0, LEAF_LONG_BUS)]), _pressure(sent[(0x1C3, LEAF_LONG_BUS)])), (t, pressure),
+                         msg=f"{accel=} {stopping=}")
+
+  def test_controller_silent_without_long(self):
+    _, sent = self._run_controller(False, -2.5)
+    self.assertFalse({0x2B0, 0x1C3} & {addr for addr, _ in sent})
+
+  def _drive(self, car_t, accel, car_name=CAR.LEAF, frames=250, dt=0.01):
+    """Run the real interface: openpilot asks for `accel`, the car reports (via 0x180) acting on T `car_t`."""
+    CI = CarInterface(_get_params(car_name, _fp(car_name=car_name), True), CarController, CarState)
+    self.assertIn(LEAF_FEEDBACK_ADDR, CI.cp.vl if car_name == CAR.LEAF else CI.cp_cam.vl)
+    packer = CANPacker("nissan_leaf_2018")
+    CC = car.CarControl.new_message()
+    CC.enabled = CC.latActive = CC.longActive = True
+    CC.actuators.accel = accel
+    d = round(-0.796 * car_t + 2067.1)
+    fb_bus = 0 if car_name == CAR.LEAF else 1
+    faults, now = [], 0
+    for _ in range(frames):
+      msgs = [packer.make_can_msg("WHEEL_SPEEDS_REAR", 0, {"WHEEL_SPEED_RR": 36, "WHEEL_SPEED_RL": 36}),   # 36 km/h = 10 m/s
+              packer.make_can_msg("WHEEL_SPEEDS_FRONT", 0, {"WHEEL_SPEED_FR": 36, "WHEEL_SPEED_FL": 36}),
+              packer.make_can_msg("PROPULSION_FEEDBACK", fb_bus, {"D": d})]
+      out = CI.update(CC, [can_list_to_can_capnp(msgs)])
+      faults.append(out.accFaulted)
+      CI.apply(CC, None, now)
+      now += int(dt * 1e9)
+    self.assertAlmostEqual(CI.CS.leaf_feedback, car_t, delta=1)
+    return faults
+
+  def test_follow_check_faults_when_car_slows_less_than_asked(self):
+    # openpilot asks for -0.5 m/s^2 (T ~2730) but the car acts on T 2528 (~0): not relaying
+    for car_name in LEAFS:
+      faults = self._drive(car_t=2528, accel=-0.5, car_name=car_name)
+      self.assertFalse(any(faults[:110]), car_name)
+      self.assertTrue(all(faults[150:]), car_name)
+
+  def test_follow_check_quiet_when_car_follows_or_slows_more(self):
+    self.assertFalse(any(self._drive(car_t=2730, accel=-0.5)))   # follows
+    self.assertFalse(any(self._drive(car_t=2784, accel=0.0)))    # slows more than asked: stock winning
+
+  def test_follow_check_timing_is_rate_independent(self):
+    # same ~1.16 s to fault whether controlsd runs at 100 Hz or 50 Hz (now_nanos-based)
+    for dt in (0.01, 0.02):
+      faults = self._drive(car_t=2528, accel=-0.5, frames=round(2.0 / dt), dt=dt)
+      first = faults.index(True) * dt
+      self.assertTrue(1.1 <= first <= 1.3, (dt, first))
+
+  def test_follow_check_releases_when_long_inactive(self):
+    m = carcontroller.FollowMonitor()
+    for i in range(200):
+      m.update(2730, 2528, True, True, i * 0.01)
+    self.assertTrue(m.fault)
+    self.assertFalse(m.update(2595, 2528, False, True, 2.0))
+    # no clock: never raises, never faults
+    self.assertFalse(carcontroller.FollowMonitor().update(2730, 2528, True, True, None))
+    CI = CarInterface(_get_params(CAR.LEAF, _fp(), True), CarController, CarState)
+    CC = car.CarControl.new_message()
+    CC.longActive = True
+    CI.update(CC, [])
+    CI.apply(CC, None, None)
+    self.assertFalse(CI.CS.gw_follow_fault)
+    self.assertFalse(m.fault)
+
+  def test_follow_monitor_matches_spec(self):
+    try:
+      from selfdrive.car.nissan import leaf_gw_long as spec
+    except ImportError:
+      raise unittest.SkipTest("leaf_gw_long.py not copied into selfdrive/car/nissan")
+    self.assertEqual((carcontroller.FollowMonitor.LAG, carcontroller.FollowMonitor.TOL, carcontroller.FollowMonitor.WINDOW),
+                     (spec.FOLLOW_LAG, spec.FOLLOW_TOL, spec.FOLLOW_WINDOW))
+    seq = [(2730, 2528, True, True)] * 50 + [(3415, 2528, True, True)] * 5 + [(2730, None, True, True)] * 20 + \
+          [(2730, 2528, True, False)] * 10 + [(2730, 2528, True, True)] * 150 + [(2595, 2528, False, True)] * 3 + \
+          [(2730, 2700, True, True)] * 30 + [(2730, 2528, True, True)] * 120
+    for dt in (0.01, 0.02, 0.013):
+      ours, theirs = carcontroller.FollowMonitor(), spec.FollowMonitor()
+      for i, args in enumerate(seq):
+        self.assertEqual(ours.update(*args, i * dt), theirs.update(*args, i * dt), (dt, i))
+      self.assertTrue(ours.fault)
+    # the DBC's PROPULSION_FEEDBACK.D is the spec's 0x180 field, signed
+    for d in (229, -300, 2047, -2048):
+      dat = CANPacker("nissan_leaf_2018").make_can_msg("PROPULSION_FEEDBACK", 0, {"D": d})[2]
+      self.assertAlmostEqual(spec.feedback_t(dat), (2067.1 - d) / 0.796)
+
+  def test_accel_limits(self):
+    CP = _get_params(CAR.LEAF, _fp(), True)
+    self.assertEqual(CarInterface.get_pid_accel_limits(CP, 10., 20.), (CarControllerParams.ACCEL_MIN, CarControllerParams.ACCEL_MAX))
+    actuators, _ = self._run_controller(True, -9.)
+    self.assertEqual(actuators.accel, CarControllerParams.ACCEL_MIN)
+
+  def test_ui_debug_line(self):
+    # the Android UI flags "System Unresponsive!" without a "0..." debug line every 500 ms
+    for long in (False, True):
+      with mock.patch.object(carcontroller.sLogger, "Send") as send:
+        self._run_controller(long, -0.5, frames=10)  # 10 frames = 200 ms at controlsd's 50 Hz
+      lines = [c.args[0] for c in send.call_args_list]
+      self.assertEqual(len(lines), 2)
+      self.assertTrue(all(line.startswith("0") for line in lines), lines)
+      self.assertEqual(lines[0], "0leaf-gw T2730 P0" if long else "0nissan")
+
+
+if __name__ == "__main__":
+  unittest.main()
