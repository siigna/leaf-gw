@@ -19,6 +19,31 @@ const CanMsg NISSAN_TX_MSGS[] = {
   {0x280, 2, 8}   // CANCEL_MSG (Leaf)
 };
 
+// leaf-gw longitudinal: openpilot sends the real 0x2B0 (propulsion/regen) and
+// 0x1C3 (friction brake) on the gateway's control bus (V-CAN). Bound them with
+// the shared longitudinal helpers; the gateway re-emits onto Chassis CAN and keeps
+// stock AEB by magnitude arbitration.
+#define NISSAN_GW_BUS 2
+const LongitudinalLimits NISSAN_LONG_LIMITS = {
+  // 0x2B0 T is a decel-up scale: "gas" here is just the bounded command range
+  .max_gas = 3415,       // PROPILOT_BRAKE_RAW (stock friction-brake marker, most decel)
+  .min_gas = 2272,       // most acceleration openpilot may request (~+0.8 m/s^2)
+  .inactive_gas = 2595,  // PROPILOT_INACTIVE_RAW (stock idle frame)
+  .max_brake = 659,      // 0x1C3 pressure ceiling (0.5-count units)
+};
+
+// Leaf longitudinal adds the real 0x2B0/0x1C3 on the leaf-gw control bus.
+const CanMsg NISSAN_LEAF_LONG_TX_MSGS[] = {
+  {0x169, 0, 8},  // LKAS
+  {0x2b1, 0, 8},  // PROPILOT_HUD
+  {0x4cc, 0, 8},  // PROPILOT_HUD_INFO_MSG
+  {0x20b, 2, 6},  // CRUISE_THROTTLE (X-Trail)
+  {0x20b, 1, 6},  // CRUISE_THROTTLE (Altima)
+  {0x280, 2, 8},  // CANCEL_MSG (Leaf)
+  {0x2b0, NISSAN_GW_BUS, 8},  // ADAS propulsion/regen
+  {0x1c3, NISSAN_GW_BUS, 8},  // ADAS friction brake
+};
+
 // Signals duplicated below due to the fact that these messages can come in on either CAN bus, depending on car model.
 AddrCheckStruct nissan_addr_checks[] = {
   {.msg = {{0x2, 0, 5, .expected_timestep = 10000U},
@@ -35,10 +60,34 @@ AddrCheckStruct nissan_addr_checks[] = {
            {0x1cc, 0, 4, .expected_timestep = 10000U}}}, // DOORS_LIGHTS (10Hz) / BRAKE (100Hz)
 };
 #define NISSAN_ADDR_CHECK_LEN (sizeof(nissan_addr_checks) / sizeof(nissan_addr_checks[0]))
+
+// Leaf longitudinal also requires the leaf-gw heartbeat (0x5FF, 50 Hz) on the
+// gateway bus: no gateway installed or alive -> rx checks lag -> no control.
+AddrCheckStruct nissan_leaf_long_addr_checks[] = {
+  {.msg = {{0x2, 0, 5, .expected_timestep = 10000U},
+           {0x2, 1, 5, .expected_timestep = 10000U}, { 0 }}},  // STEER_ANGLE_SENSOR (100Hz)
+  {.msg = {{0x285, 0, 8, .expected_timestep = 20000U},
+           {0x285, 1, 8, .expected_timestep = 20000U}, { 0 }}}, // WHEEL_SPEEDS_REAR (50Hz)
+  {.msg = {{0x30f, 2, 3, .expected_timestep = 100000U},
+           {0x30f, 1, 3, .expected_timestep = 100000U}, { 0 }}}, // CRUISE_STATE (10Hz)
+  {.msg = {{0x15c, 0, 8, .expected_timestep = 20000U},
+           {0x15c, 1, 8, .expected_timestep = 20000U},
+           {0x239, 0, 8, .expected_timestep = 20000U}}}, // GAS_PEDAL (100Hz / 50Hz)
+  {.msg = {{0x454, 0, 8, .expected_timestep = 100000U},
+           {0x454, 1, 8, .expected_timestep = 100000U},
+           {0x1cc, 0, 4, .expected_timestep = 10000U}}}, // DOORS_LIGHTS (10Hz) / BRAKE (100Hz)
+  {.msg = {{0x5ff, NISSAN_GW_BUS, 8, .expected_timestep = 20000U}, { 0 }, { 0 }}},  // LEAF_GW_HEARTBEAT (50Hz)
+};
+#define NISSAN_LEAF_LONG_ADDR_CHECK_LEN (sizeof(nissan_leaf_long_addr_checks) / sizeof(nissan_leaf_long_addr_checks[0]))
+
 addr_checks nissan_rx_checks = {nissan_addr_checks, NISSAN_ADDR_CHECK_LEN};
 
+const uint16_t NISSAN_PARAM_ALT_EPS_BUS = 1;
+const uint16_t NISSAN_PARAM_LEAF_LONG = 2;
+
 // EPS Location. false = V-CAN, true = C-CAN
 bool nissan_alt_eps = false;
+bool nissan_leaf_long = false;
 
 static int nissan_rx_hook(CANPacket_t *to_push) {
 
@@ -105,8 +154,14 @@ static int nissan_tx_hook(CANPacket_t *to_send) {
   int addr = GET_ADDR(to_send);
   bool violation = false;
 
-  if (!msg_allowed(to_send, NISSAN_TX_MSGS, sizeof(NISSAN_TX_MSGS) / sizeof(NISSAN_TX_MSGS[0]))) {
-    tx = 0;
+  if (nissan_leaf_long) {
+    if (!msg_allowed(to_send, NISSAN_LEAF_LONG_TX_MSGS, sizeof(NISSAN_LEAF_LONG_TX_MSGS) / sizeof(NISSAN_LEAF_LONG_TX_MSGS[0]))) {
+      tx = 0;
+    }
+  } else {
+    if (!msg_allowed(to_send, NISSAN_TX_MSGS, sizeof(NISSAN_TX_MSGS) / sizeof(NISSAN_TX_MSGS[0]))) {
+      tx = 0;
+    }
   }
 
   // steer cmd checks
@@ -128,6 +183,23 @@ static int nissan_tx_hook(CANPacket_t *to_send) {
     violation |= ((GET_BYTE(to_send, 1) & 0x3dU) > 0U);
   }
 
+  // leaf-gw propulsion/regen request (0x2B0)
+  if (addr == 0x2b0) {
+    // T = data[2] << 4 | data[1] low nibble (inverted copy in data[1] high nibble + data[0])
+    int command = (GET_BYTE(to_send, 2) << 4) | (GET_BYTE(to_send, 1) & 0x0FU);
+    if (longitudinal_gas_checks(command, NISSAN_LONG_LIMITS)) {
+      violation = true;
+    }
+  }
+
+  // leaf-gw friction-brake request (0x1C3)
+  if (addr == 0x1c3) {
+    int pressure = ((GET_BYTE(to_send, 0) & 0x3FU) << 4) | (GET_BYTE(to_send, 1) >> 4);
+    if (longitudinal_brake_checks(pressure, NISSAN_LONG_LIMITS)) {
+      violation = true;
+    }
+  }
+
   if (violation) {
     tx = 0;
   }
@@ -158,7 +230,13 @@ static int nissan_fwd_hook(int bus_num, int addr) {
 }
 
 static const addr_checks* nissan_init(uint16_t param) {
-  nissan_alt_eps = param ? 1 : 0;
+  nissan_alt_eps = GET_FLAG(param, NISSAN_PARAM_ALT_EPS_BUS);
+  nissan_leaf_long = GET_FLAG(param, NISSAN_PARAM_LEAF_LONG);
+  if (nissan_leaf_long) {
+    nissan_rx_checks = (addr_checks){nissan_leaf_long_addr_checks, NISSAN_LEAF_LONG_ADDR_CHECK_LEN};
+  } else {
+    nissan_rx_checks = (addr_checks){nissan_addr_checks, NISSAN_ADDR_CHECK_LEN};
+  }
   return &nissan_rx_checks;
 }
 
