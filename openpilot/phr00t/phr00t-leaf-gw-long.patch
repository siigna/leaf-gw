     pass
 
 
+def _msg(bus, addr, dat):
+  return libpanda_py.make_CANPacket(addr, bus, bytes(dat))
+
+
+class TestNissanLeafLongSafety(TestNissanLeafSafety):
+  """Leaf longitudinal via the leaf-gw gateway. openpilot TXes the real 0x2B0 / 0x1C3
+  on the gateway's control bus (V-CAN, bus 2); panda bounds them with the shared
+  longitudinal helpers and gates on controls_allowed + gas-not-pressed."""
+
+  TX_MSGS = [[0x169, 0], [0x2b1, 0], [0x4cc, 0], [0x20b, 2], [0x280, 2], [0x2b0, 2], [0x1c3, 2]]
+
+  # mirrors selfdrive/car/nissan CarControllerParams and safety_nissan.h NISSAN_LONG_LIMITS
+  GW_BUS = 2
+  MAX_GAS = 3415       # 0x2B0 T: higher = more decel; the brake marker is the top
+  MIN_GAS = 2272
+  INACTIVE_GAS = 2595
+  MAX_BRAKE = 659
+
+  def setUp(self):
+    self.packer = CANPackerPanda("nissan_leaf_2018")
+    self.safety = libpanda_py.libpanda
+    self.safety.set_safety_hooks(Panda.SAFETY_NISSAN, Panda.FLAG_NISSAN_LEAF_LONG)
+    self.safety.init_tests()
+
+  def _accel_msg(self, command, active=True):
+    t = int(command)
+    inverse = (~t) & 0xFFF
+    aux = 2 if t == self.MAX_GAS else 0
+    return _msg(self.GW_BUS, 0x2b0, [
+      inverse & 0xFF,
+      (((inverse >> 8) & 0xF) << 4) | (t & 0xF),
+      (t >> 4) & 0xFF,
+      0xAC, 0x5B if active else 0x1B, 0x00, 0x0E,
+      (aux << 2) | ((~aux) & 0x3),
+    ])
+
+  def _brake_msg(self, pressure, active=True, brake_mode=False):
+    dat = bytearray(8)
+    dat[0] = (int(pressure) >> 4) & 0x3F
+    dat[1] = (int(pressure) & 0xF) << 4
+    dat[4] = 0x64
+    dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0)
+    dat[6] = 0xFF
+    dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+    return _msg(self.GW_BUS, 0x1c3, dat)
+
+  def _heartbeat_msg(self, counter=0, bus=GW_BUS):
+    dat = bytes(b"LGW\x01\x01") + bytes([counter & 0xF, 0])
+    return _msg(bus, 0x5ff, dat + bytes([(0xFF + sum(dat)) & 0xFF]))
+
+  def test_leaf_gas_limits(self):
+    for allowed in (True, False):
+      self.safety.set_controls_allowed(allowed)
+      for cmd in [*range(0, 4096, 7), self.MIN_GAS - 1, self.MIN_GAS, self.MAX_GAS, self.MAX_GAS + 1, self.INACTIVE_GAS]:
+        should_tx = (allowed and self.MIN_GAS <= cmd <= self.MAX_GAS) or cmd == self.INACTIVE_GAS
+        self.assertEqual(should_tx, self._tx(self._accel_msg(cmd)), msg=f"{allowed=} gas={cmd}")
+
+  def test_leaf_brake_limits(self):
+    for allowed in (True, False):
+      self.safety.set_controls_allowed(allowed)
+      for p in [*range(0, 1024, 7), self.MAX_BRAKE, self.MAX_BRAKE + 1]:
+        should_tx = p == 0 or (allowed and p <= self.MAX_BRAKE)
+        self.assertEqual(should_tx, self._tx(self._brake_msg(p, active=p > 0, brake_mode=p > 0)), msg=f"{allowed=} brake={p}")
+
+  def test_leaf_long_only_on_gateway_bus(self):
+    self.safety.set_controls_allowed(True)
+    for bus in (0, 1):
+      self.assertFalse(self._tx(_msg(bus, 0x2b0, bytes.fromhex("a827d5ac5b000e09"))))
+      self.assertFalse(self._tx(_msg(bus, 0x1c3, bytes(8))))
+
+  def test_leaf_stock_frames(self):
+    # golden stock ZE1 frames: idle == inactive (always allowed), brake marker == max T
+    idle, marker = bytes.fromhex("dc53a2ac1b000e03"), bytes.fromhex("a827d5ac5b000e09")
+    self.safety.set_controls_allowed(False)
+    self.assertTrue(self._tx(_msg(self.GW_BUS, 0x2b0, idle)))
+    self.assertFalse(self._tx(_msg(self.GW_BUS, 0x2b0, marker)))
+    self.safety.set_controls_allowed(True)
+    self.assertTrue(self._tx(_msg(self.GW_BUS, 0x2b0, marker)))
+
+  def test_leaf_gas_pressed_blocks(self):
+    # driver on the accelerator -> longitudinal not allowed even while engaged
+    self.safety.set_alternative_experience(ALTERNATIVE_EXPERIENCE.DISABLE_DISENGAGE_ON_GAS)
+    self.safety.set_controls_allowed(True)
+    self._rx(self._user_gas_msg(self.GAS_PRESSED_THRESHOLD + 1))
+    self.assertTrue(self.safety.get_controls_allowed())
+    self.assertFalse(self._tx(self._accel_msg(2500)))
+    self.assertFalse(self._tx(self._brake_msg(200)))
+    self.assertTrue(self._tx(self._accel_msg(self.INACTIVE_GAS, active=False)))
+    self.assertTrue(self._tx(self._brake_msg(0, active=False)))
+    self._rx(self._user_gas_msg(0))
+    self.assertTrue(self._tx(self._accel_msg(2500)))
+
+  def _feed_rx_checks(self, heartbeat):
+    self._rx(self._angle_meas_msg(0))
+    self._rx(self._speed_msg(0))
+    self._rx(self._pcm_status_msg(True))
+    self._rx(self._user_gas_msg(0))
+    self._rx(_msg(0, 0x1cc, bytes(4)))  # BRAKE (Leaf sends 4 bytes)
+    if heartbeat:
+      self.assertTrue(self._rx(self._heartbeat_msg()))
+
+  def _run_for(self, seconds, heartbeat, heartbeat_bus=None):
+    for _ in range(int(seconds * 50)):
+      self.t += 20000
+      self.safety.set_timer(self.t)
+      self._feed_rx_checks(heartbeat)
+      if heartbeat_bus is not None:
+        self._rx(self._heartbeat_msg(bus=heartbeat_bus))
+    self.safety.safety_tick_current_rx_checks()
+
+  def test_leaf_gateway_heartbeat_required(self):
+    # LONG mode monitors the heartbeat as an rx check: when it stops, the safety
+    # tick drops controls_allowed
+    self.t = 0
+    self.safety.set_timer(self.t)
+    self.safety.set_controls_allowed(True)
+    self._run_for(3, heartbeat=True)
+    self.assertTrue(self.safety.addr_checks_valid())
+    self.assertTrue(self.safety.get_controls_allowed())
+    self._run_for(1.5, heartbeat=False)
+    self.assertFalse(self.safety.get_controls_allowed())
+    # ... and only the gateway bus counts
+    self.safety.set_controls_allowed(True)
+    self._run_for(1.5, heartbeat=False, heartbeat_bus=0)
+    self.assertFalse(self.safety.get_controls_allowed())
+
+  def test_leaf_heartbeat_not_checked_without_long(self):
+    # lateral-only Leafs need no gateway: a missing heartbeat never drops control
+    self.safety.set_safety_hooks(Panda.SAFETY_NISSAN, 0)
+    self.t = 0
+    self.safety.set_timer(self.t)
+    self.safety.set_controls_allowed(True)
+    self._run_for(3, heartbeat=False)
+    self.assertTrue(self.safety.get_controls_allowed())
+
+
 if __name__ == "__main__":
   unittest.main()
