# Minimal host build for the phr00t/flowpilot car/safety tests: copied to the worktree root by fork.sh, not part of the tree.
AddOption("--test", action="store_true")
import os, subprocess, sysconfig
py = lambda c: subprocess.check_output([os.environ["FP_PY"], "-c", c], encoding="utf8").strip()
py_inc = py("import sysconfig;print(sysconfig.get_paths()['include'])")
np_inc = py("import numpy;print(numpy.get_include())")
inc = os.environ["FP_INC"].split(":")
lib = os.environ["FP_LIB"].split(":")
env = Environment(ENV=os.environ, CC='clang', CXX='clang++',
  CCFLAGS=["-g", "-fPIC", "-O2", "-Wno-unused-command-line-argument", "-Wno-deprecated-declarations"],
  CFLAGS=["-std=gnu11"], CXXFLAGS=["-std=c++17", "-include", "iterator"],
  CPPPATH=["#", "#opendbc/can", "#cereal", "#common", "#third_party"] + inc,
  LIBPATH=["#common", "#opendbc/can", "#cereal"] + lib, RPATH=lib + [Dir("#opendbc/can").abspath, Dir("#selfdrive/boardd").abspath, Dir("#cereal").abspath],
  CYTHONCFILESUFFIX=".cpp", toolpath=['opendbc/site_scons/site_tools'], tools=["default", "cython"])
env["ENV"]["PATH"] = os.path.dirname(os.environ["FP_PY"]) + ":" + os.environ["PATH"]
envCython = env.Clone()
envCython["CPPPATH"] += [py_inc, np_inc]
envCython["CCFLAGS"] += ["-Wno-#warnings", "-Wno-shadow"]
envCython["LINKFLAGS"] = ["-pthread", "-shared"]
envCython["LIBS"] = []
_common = env.Library('common/common_test', ['common/params.cc', 'common/util.cc'])
common = [_common, 'lmdb']
arch = 'x86_64'
Export('env', 'envCython', 'arch', 'common')
envCython.Program('common/params_pyx.so', 'common/params_pyx.pyx', LIBS=[_common, 'lmdb'])
# opendbc/can/SConscript links -lpython3.11; build the same targets here against this env's python
env.Command(['opendbc/can/msg.capnp.c++', 'opendbc/can/msg.capnp.h'], ['opendbc/can/msg.capnp'], 'capnp compile -oc++ $SOURCE')
envDBC = env.Clone()
envDBC['CXXFLAGS'] += ['-DDBC_FILE_PATH=\'"%s"\'' % Dir('#opendbc').abspath]
libdbc = envDBC.SharedLibrary('opendbc/can/libdbc', ['opendbc/can/' + f for f in ['dbc.cc', 'parser.cc', 'packer.cc', 'common.cc']], LIBS=['capnp', 'kj', 'zmq'])
envCython.Program('opendbc/can/parser_pyx.so', 'opendbc/can/parser_pyx.pyx', LIBS=[libdbc])
envCython.Program('opendbc/can/packer_pyx.so', 'opendbc/can/packer_pyx.pyx', LIBS=[libdbc])
SConscript(['cereal/SConscript'])
envCython.Program('common/clock.so', 'common/clock.pyx')
c2c = env.SharedLibrary('selfdrive/boardd/libcan_list_to_can_capnp', ['selfdrive/boardd/can_list_to_can_capnp.cc'], LIBS=['capnp', 'kj'])
# its bare `cdef extern` must keep C linkage, which needs Cython 0.29 (see shell.nix)
envCython.Clone(CYTHON=os.environ["FP_CYTHON0"]).Program('selfdrive/boardd/boardd_api_impl.so', 'selfdrive/boardd/boardd_api_impl.pyx', LIBS=[c2c])
envCython.Program('common/kalman/simple_kalman_impl.so', 'common/kalman/simple_kalman_impl.pyx')
envCython.Program('common/transformations/transformations.so', 'common/transformations/transformations.pyx')
