   LKAS_MAX_TORQUE = 1               # A value of 1 is easy to overpower
   STEER_THRESHOLD = 1.0
 
+  # 2025 Leaf ProPILOT longitudinal limits. The propulsion/regen request (0x2B0)
+  # has 2048 counts per m/s^2 about a 6144-count zero; friction braking (0x1C3)
+  # blends in below -1 m/s^2. From the StarPilot fork (2025 SV Plus).
+  ACCEL_MIN = -3.5
+  ACCEL_MAX = 2047 / 2048
+  PROPILOT_ACCEL_MIN = -1.0
+  PROPILOT_ACCEL_MAX = ACCEL_MAX
+  PROPILOT_ACCEL_OFFSET = 6144
+  PROPILOT_ACCEL_SCALE = 2048
+  PROPILOT_INACTIVE_RAW = 5260  # stock idle frame
+  PROPILOT_BRAKE_RAW = 2398     # stock friction-brake marker
+  BRAKE_MAX = 659
+  BRAKE_GAIN = 264.0
+
   def __init__(self, CP):
     pass
 
 
 class NissanSafetyFlags(IntFlag):
   ALT_EPS_BUS = 1
+  LONG_CONTROL = 2
 
 
 class Footnote(Enum):
