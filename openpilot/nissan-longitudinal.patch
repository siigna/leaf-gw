--- a/opendbc/car/nissan/nissancan.py
+++ b/opendbc/car/nissan/nissancan.py
@@ -1,6 +1,17 @@
+from opendbc.car import CanData
 from opendbc.car.crc import CRC8J1850, mk_crc8_fun
 from opendbc.car.nissan.values import CAR
 
+# Bus the leaf-gw gateway taps to read these frames (V-CAN; the comma already
+# drives it for steering). Which V-CAN segment / panda bus is a bench check.
+LEAF_LONG_BUS = 2
+# The gateway's 50 Hz heartbeat on LEAF_LONG_BUS: longitudinal is offered only when
+# the fingerprint saw it, and panda drops control if it stops.
+LEAF_GW_HEARTBEAT = 0x5FF
+# 0x180 follows T ~160 ms later; the controller checks the car is doing what it sent.
+# Panda bus 0 on the Nissan A harness, bus 1 on the IC harness.
+LEAF_FEEDBACK_ADDR = 0x180
+
 # TODO: add this checksum to the CANPacker
 nissan_checksum = mk_crc8_fun(CRC8J1850, init_crc=0x00, xor_out=0xFF)
 
@@ -152,3 +163,35 @@ def create_lkas_hud_info_msg(packer, lkas_hud_info_msg, steer_hud_alert):
     values["HANDS_ON_WHEEL_WARNING"] = 1
 
   return packer.make_can_msg("PROPILOT_HUD_INFO_MSG", 0, values)
+
+
+def create_accel_command(command, frame, active):
+  """Leaf ADAS propulsion/regen request (0x2B0). command = T, higher = more decel.
+  leaf-gw re-stamps the counter and stock state byte and re-emits it on Chassis CAN."""
+  t = int(min(max(int(command), 0), 4095))
+  inverse = (~t) & 0xFFF
+  aux = 2 if t == 3415 else 0   # stock pairs the friction-brake marker with aux 2
+  dat = bytes([
+    inverse & 0xFF,
+    (((inverse >> 8) & 0xF) << 4) | (t & 0xF),
+    (t >> 4) & 0xFF,
+    0xAC,
+    0x5B if active else 0x1B,
+    0x00,
+    ((frame & 0xF) << 4) | 0xE,
+    (aux << 2) | ((~aux) & 0x3),
+  ])
+  return CanData(0x2B0, dat, LEAF_LONG_BUS)
+
+
+def create_brake_command(pressure, frame, active, brake_mode):
+  """Leaf ADAS friction-brake request (0x1C3), pressure in 0.5-count units."""
+  pressure = int(pressure)
+  dat = bytearray(8)
+  dat[0] = (pressure >> 4) & 0x3F
+  dat[1] = (pressure & 0xF) << 4
+  dat[4] = 0x64
+  dat[5] = (0x80 if active else 0) | (0x04 if brake_mode else 0) | (frame & 0x3)
+  dat[6] = 0xFF
+  dat[7] = (0x01 + 0xC3 + sum(dat[:7])) & 0xFF
+  return CanData(0x1C3, bytes(dat), LEAF_LONG_BUS)
diff --git a/opendbc/car/nissan/tests/test_leaf_gw.py b/opendbc/car/nissan/tests/test_leaf_gw.py
new file mode 100644
index 00000000..ff00db6e
--- /dev/null
+++ b/opendbc/car/nissan/tests/test_leaf_gw.py
@@ -0,0 +1,101 @@
+from opendbc.car import gen_empty_fingerprint
+from opendbc.car.nissan.interface import CarInterface
+from opendbc.can import CANPacker
+from opendbc.car import Bus, DT_CTRL, structs
+from opendbc.car.nissan.nissancan import LEAF_FEEDBACK_ADDR, LEAF_GW_HEARTBEAT, LEAF_LONG_BUS, create_accel_command
+from opendbc.car.nissan.values import DBC
+from opendbc.car.nissan.values import CAR, CarControllerParams, NissanSafetyFlags
+
+
+def _fp(gateway=True, feedback=True, car=CAR.NISSAN_LEAF):
+  fp = gen_empty_fingerprint()
+  if gateway:
+    fp[LEAF_LONG_BUS][LEAF_GW_HEARTBEAT] = 8
+  if feedback:
+    fp[0 if car == CAR.NISSAN_LEAF else 1][LEAF_FEEDBACK_ADDR] = 8
+  return fp
+
+
+def test_leaf_gateway_long_keeps_pcm_cruise():
+  # openpilot cancels stock cruise when pcmCruise is False, and panda only allows
+  # control while stock cruise is engaged -- so gateway long must keep pcmCruise.
+  for car in (CAR.NISSAN_LEAF, CAR.NISSAN_LEAF_IC):
+    CP = CarInterface.get_params(car, _fp(car=car), [], True, False, False)
+    assert CP.openpilotLongitudinalControl
+    assert CP.pcmCruise
+    assert CP.safetyConfigs[0].safetyParam & NissanSafetyFlags.LONG_CONTROL.value
+
+
+def test_leaf_long_off_without_alpha_toggle():
+  CP = CarInterface.get_params(CAR.NISSAN_LEAF, _fp(), [], False, False, False)
+  assert not CP.openpilotLongitudinalControl
+  assert not CP.safetyConfigs[0].safetyParam & NissanSafetyFlags.LONG_CONTROL.value
+
+
+def test_leaf_long_needs_gateway_heartbeat():
+  for fp in (_fp(gateway=False), {**_fp(gateway=False), 0: {LEAF_GW_HEARTBEAT: 8}}):  # absent, or wrong bus
+    CP = CarInterface.get_params(CAR.NISSAN_LEAF, fp, [], True, False, False)
+    assert not CP.alphaLongitudinalAvailable
+    assert not CP.openpilotLongitudinalControl
+    assert not CP.safetyConfigs[0].safetyParam & NissanSafetyFlags.LONG_CONTROL.value
+
+
+def test_leaf_accel_frames_match_stock():
+  # stock ZE1 frames (public route): idle, friction-brake marker, neutral
+  assert create_accel_command(CarControllerParams.PROPILOT_INACTIVE_RAW, 0, False).dat.hex() == "dc53a2ac1b000e03"
+  assert create_accel_command(CarControllerParams.PROPILOT_BRAKE_RAW, 0, True).dat.hex() == "a827d5ac5b000e09"
+  assert create_accel_command(2304, 0, True).dat.hex() == "ff6090ac5b000e03"
+
+
+def test_leaf_long_controller_emits_frames():
+  # what test_car_interfaces did before the heartbeat gate made its random fingerprints miss long
+  from opendbc.car import DT_CTRL, structs
+  CI = CarInterface(CarInterface.get_params(CAR.NISSAN_LEAF, _fp(), [], True, False, False))
+  CC = structs.CarControl()
+  CC.enabled = CC.latActive = CC.longActive = True
+  CC.actuators.accel = -2.5
+  now, sent = 0, []
+  for _ in range(20):
+    CI.update([])
+    _, can_sends = CI.apply(CC.as_reader(), now)
+    sent += [(m[0], m[2]) for m in can_sends]  # CanData(address, dat, src)
+    now += int(DT_CTRL * 1e9)
+  assert (0x2B0, LEAF_LONG_BUS) in sent and (0x1C3, LEAF_LONG_BUS) in sent
+
+
+def test_leaf_long_needs_feedback_frame():
+  # 0x180 must be on the harness's bus (0 for Nissan A, 1 for IC), or long isn't offered
+  for car, fp in ((CAR.NISSAN_LEAF, _fp(feedback=False)), (CAR.NISSAN_LEAF_IC, _fp(car=CAR.NISSAN_LEAF))):
+    CP = CarInterface.get_params(car, fp, [], True, False, False)
+    assert not CP.openpilotLongitudinalControl
+
+
+def _drive(car_t, accel, frames=200):
+  """Run the real interface: openpilot asks for `accel`, the car reports (via 0x180) acting on T `car_t`."""
+  CI = CarInterface(CarInterface.get_params(CAR.NISSAN_LEAF, _fp(), [], True, False, False))
+  packer = CANPacker(DBC[CAR.NISSAN_LEAF][Bus.pt])
+  CC = structs.CarControl()
+  CC.enabled = CC.latActive = CC.longActive = True
+  CC.actuators.accel = accel
+  d = round(-0.796 * car_t + 2067.1)
+  now, faults = 0, []
+  for i in range(frames):
+    wheels = {"WHEEL_SPEED_RR": 36, "WHEEL_SPEED_RL": 36}   # 36 km/h = 10 m/s
+    msgs = [packer.make_can_msg("WHEEL_SPEEDS_REAR", 0, wheels), packer.make_can_msg("WHEEL_SPEEDS_FRONT", 0, {"WHEEL_SPEED_FR": 36, "WHEEL_SPEED_FL": 36}),
+            packer.make_can_msg("PROPULSION_FEEDBACK", 0, {"D": d})]
+    out = CI.update([(now, msgs)])
+    faults.append(out.accFaulted)
+    CI.apply(CC.as_reader(), now)
+    now += int(DT_CTRL * 1e9)
+  return faults
+
+
+def test_follow_check_faults_when_car_slows_less_than_asked():
+  # openpilot asks for -0.5 m/s^2 (T ~2730) but the car acts on T 2528 (~0): not relaying
+  faults = _drive(car_t=2528, accel=-0.5)
+  assert not any(faults[:110]) and all(faults[130:])
+
+
+def test_follow_check_quiet_when_car_follows_or_slows_more():
+  assert not any(_drive(car_t=2730, accel=-0.5))    # follows
+  assert not any(_drive(car_t=2784, accel=0.0))     # slows more than asked: stock winning
