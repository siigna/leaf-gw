+class FollowMonitor:
+  """One-sided check that the car follows what openpilot sent through leaf-gw.
+
+  Faults when the car is slowing LESS than openpilot asked -- T from 160 ms ago minus
+  the T the car is acting on (0x180) above TOL -- for WINDOW frames: the gateway isn't
+  relaying, or the car isn't obeying. Slowing MORE than asked is fine: that's stock
+  winning the arbitration. Latches until longitudinal goes inactive. Thresholds: on
+  37 stock Leafs a perfect relay never trips (p99.9 residual 61, 0 of 127 segments)."""
+  LAG = 16       # 160 ms at 100 Hz
+  TOL = 60       # T counts
+  WINDOW = 100   # 1 s
+
+  def __init__(self):
+    self.hist = []
+    self.bad = 0
+    self.fault = False
+
+  def update(self, op_t, feedback, active, evaluate):
+    if not active:
+      self.hist, self.bad, self.fault = [], 0, False
+      return False
+    self.hist = (self.hist + [op_t])[-(self.LAG + 1):]
+    if (not evaluate or feedback is None or len(self.hist) <= self.LAG or
+        CarControllerParams.PROPILOT_BRAKE_RAW in self.hist):
+      self.bad = 0
+      return self.fault
+    self.bad = self.bad + 1 if self.hist[0] - feedback > self.TOL else 0
+    if self.bad >= self.WINDOW:
+      self.fault = True
+    return self.fault
 
 
 class CarController(CarControllerBase):
