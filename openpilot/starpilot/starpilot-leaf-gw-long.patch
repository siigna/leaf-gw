+def _drive(car_t, accel, candidate=CAR.NISSAN_LEAF, frames=200, speed_kph=36, feedback=True, dt=DT_CTRL):
+  """Run the real interface in gateway mode: openpilot asks for `accel`, the car reports
+  (via 0x180 on the harness's car bus) acting on T `car_t`. Returns accFaulted per frame."""
+  CP = CarInterface.get_params(candidate, gw_fingerprint(), [], True, False, False, TEST_TOGGLES)
+  FPCP = CarInterface.get_starpilot_params(candidate, gw_fingerprint(), [], CP, TEST_TOGGLES)
+  CI = CarInterface(CP, FPCP)
+  assert CP.safetyConfigs[-1].safetyParam == NissanSafetyFlags.LEAF_GW_LONG
+  packer = CANPacker(DBC[candidate][Bus.pt])
+  fb_bus = 0 if candidate == CAR.NISSAN_LEAF else 1
+  CC = structs.CarControl()
+  CC.enabled = CC.latActive = CC.longActive = True
+  CC.actuators.accel = accel
+  d = round(-0.796 * car_t + 2067.1)
+  now, faults = 0, []
+  for _ in range(frames):
+    msgs = [packer.make_can_msg("WHEEL_SPEEDS_REAR", 0, {"WHEEL_SPEED_RR": speed_kph, "WHEEL_SPEED_RL": speed_kph}),
+            packer.make_can_msg("WHEEL_SPEEDS_FRONT", 0, {"WHEEL_SPEED_FR": speed_kph, "WHEEL_SPEED_FL": speed_kph})]
+    if feedback:
+      msgs.append(packer.make_can_msg("PROPULSION_FEEDBACK", fb_bus, {"D": d}))
+    out, _ = CI.update([(now, msgs)], TEST_TOGGLES)
+    faults.append(out.accFaulted)
+    CI.apply(CC.as_reader(), now, TEST_TOGGLES)
+    now += int(dt * 1e9)
+  return faults
+
+
+@pytest.mark.parametrize("candidate", [CAR.NISSAN_LEAF, CAR.NISSAN_LEAF_IC])
+def test_follow_check_faults_when_car_slows_less_than_asked(candidate):
+  # openpilot asks for -0.5 m/s^2 (T ~2730) but the car acts on T 2528 (~0): not relaying
+  faults = _drive(car_t=2528, accel=-0.5, candidate=candidate)
+  assert not any(faults[:110]) and all(faults[130:])
+
+
+@pytest.mark.parametrize("candidate", [CAR.NISSAN_LEAF, CAR.NISSAN_LEAF_IC])
+def test_follow_check_quiet_when_car_follows_or_slows_more(candidate):
+  assert not any(_drive(car_t=2730, accel=-0.5, candidate=candidate))  # follows
+  assert not any(_drive(car_t=2784, accel=0.0, candidate=candidate))   # slows more than asked: stock winning
+
+
+def test_follow_check_skips_when_not_evaluable():
+  assert not any(_drive(car_t=2528, accel=-0.5, speed_kph=5))      # below 2 m/s
+  assert not any(_drive(car_t=2528, accel=-0.5, feedback=False))   # no feedback frames
+  assert not any(_drive(car_t=2528, accel=-2.0))                   # brake marker in the history
+
+
+def test_follow_monitor_latches_until_inactive():
+  from opendbc.car.nissan.carcontroller import FollowMonitor
+  m = FollowMonitor()
+  now = 0.0
+  while not m.fault and now < 5.0:
+    m.update(2730, 2528, True, True, now)
+    now += DT_CTRL
+  assert m.fault and 1.1 <= now <= 1.3
+  assert m.update(2528, 2528, True, False, now)       # stays latched while active
+  assert not m.update(2528, 2528, False, True, now)   # cleared when long goes inactive
+  assert m.update(2730, 2528, True, True, None) is False  # no clock: no check, no crash
+
+
+def test_follow_check_timing_is_rate_independent():
+  # same ~1.16 s to fault whether the controller runs at 100 Hz or 50 Hz
+  for dt in (0.01, 0.02):
+    faults = _drive(car_t=2528, accel=-0.5, frames=round(2.0 / dt), dt=dt)
+    first = faults.index(True) * dt
+    assert 1.1 <= first <= 1.3, (dt, first)
