+    # keep the stock frames alive for 3 s while the heartbeat stops
+    for t in range(1, 31):
+      self.safety.set_timer(t * 100000)
+      self._rx_stock_checks()
+      self.safety.safety_tick_current_safety_config()
+    self.assertFalse(self.safety.get_controls_allowed())
+    self.assertFalse(self.safety.safety_config_valid())
+
+  def test_heartbeat_not_required_in_other_modes(self):
+    for param in (0, NissanSafetyFlags.LONG_CONTROL):
+      self.safety.set_safety_hooks(CarParams.SafetyModel.nissan, param)
+      self._rx_stock_checks()
+      self.assertTrue(self.safety.safety_config_valid(), param)
