+class TestNissanLeafGwLongSafety(TestNissanLeafSafety):
+  """leaf-gw gateway mode: the real 0x2B0/0x1C3 go to the inline gateway on bus 2.
+  The ADAS ECU stays live, so there is no 0x707 takeover and no bus 1 command path,
+  and stock CRUISE_STATE still gates controls_allowed (pcmCruise)."""
+
+  SAFETY_PARAM = NissanSafetyFlags.LEAF_GW_LONG
+  LONG_BUS = 2
+  TX_MSGS = [*TestNissanLeafSafety.TX_MSGS, [0x2B0, 2], [0x1C3, 2]]
+
+  MAX_GAS = 8191
+  MIN_GAS = 2398
+  INACTIVE_GAS = 5260
+  MAX_BRAKE = 659
+
+  setUp = TestNissanLeafLongSafety.setUp
+  _make_msg = staticmethod(TestNissanLeafLongSafety._make_msg)
+  _accel_msg = TestNissanLeafLongSafety._accel_msg
+  _brake_msg = TestNissanLeafLongSafety._brake_msg
+  _button_msg = TestNissanLeafLongSafety._button_msg
+
+  # same frame validation as the silencing mode, on bus 2
+  test_accel_command_limits_and_inactive = TestNissanLeafLongSafety.test_accel_command_limits_and_inactive
+  test_accel_redundancy_and_constants = TestNissanLeafLongSafety.test_accel_redundancy_and_constants
+  test_brake_command_limits_and_format = TestNissanLeafLongSafety.test_brake_command_limits_and_format
+  test_gas_override_blocks_longitudinal_commands = TestNissanLeafLongSafety.test_gas_override_blocks_longitudinal_commands
+
+  def test_set_and_resume_do_not_enable(self):
+    # engagement comes from stock ProPILOT (CRUISE_STATE), never from openpilot-read buttons
+    for button in ("set_button", "res_button"):
+      self.safety.set_controls_allowed(False)
+      self._rx(self._button_msg(main=True, **{button: True}))
+      self._rx(self._button_msg(main=True))
+      self.assertFalse(self.safety.get_controls_allowed())
+
+  def test_tester_present_rejected(self):
+    # the ADAS ECU is never taken over in gateway mode
+    self.safety.set_controls_allowed(True)
+    self.assertFalse(self._tx(self._make_msg(nissancan.create_leaf_adas_tester_present())))
+
+  def test_bus_1_commands_rejected(self):
+    for controls_allowed in (False, True):
+      self.safety.set_controls_allowed(controls_allowed)
+      self.assertFalse(self._tx(self._accel_msg(5260, active=False, bus=1)))
+      self.assertFalse(self._tx(self._accel_msg(6144, bus=1)))
+      self.assertFalse(self._tx(self._brake_msg(0, active=False, brake_mode=False, bus=1)))
+      self.assertFalse(self._tx(self._brake_msg(200, bus=1)))
+
+  def test_gas_sweep_bounded(self):
+    # only the inactive value when disengaged; within [MIN_GAS, MAX_GAS] (and the
+    # StarPilot command shape: brake-raw or 4096..8191) when engaged
+    for controls_allowed in (False, True):
+      self.safety.set_controls_allowed(controls_allowed)
+      for raw_command in range(0, 0x4000, 7):
+        for active in (False, True):
+          if not active:
+            should_tx = raw_command == self.INACTIVE_GAS
+          else:
+            should_tx = controls_allowed and (raw_command == self.MIN_GAS or 4096 <= raw_command <= self.MAX_GAS)
+          self.assertEqual(should_tx, self._tx(self._accel_msg(raw_command, active=active)), (raw_command, active))
+
+  def test_brake_sweep_bounded(self):
+    for controls_allowed in (False, True):
+      self.safety.set_controls_allowed(controls_allowed)
+      for pressure in range(0, 1024):
+        should_tx = (pressure == 0) or (controls_allowed and pressure <= self.MAX_BRAKE)
+        self.assertEqual(should_tx, self._tx(self._brake_msg(pressure, brake_mode=pressure > 0)), pressure)
