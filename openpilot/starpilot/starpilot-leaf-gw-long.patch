+  assert all(x >= y for x, y in zip(ts, ts[1:], strict=False))
+  assert ts[0] == C.T_BP[0] and ts[-1] == C.T_BP[-1]
+  assert round(float(np.interp(0.0, C.ACCEL_BP, C.T_BP))) == 2528
