+def test_leaf_accel_command_layout():
+  # T (higher = more decel), I = ~T: byte0 = I & 0xFF, byte1 = I_hi:T_lo, byte2 = T >> 4, aux 2 only at the brake marker
+  from opendbc.car.nissan.values import CarControllerParams
+  for t in range(0x1000):
+    dat = nissancan.create_accel_command(t, 0, True).dat
+    inverse = (~t) & 0xFFF
+    aux = 2 if t == CarControllerParams.PROPILOT_BRAKE_RAW else 0
+    assert dat[0] == inverse & 0xFF
+    assert dat[1] == ((inverse >> 8) << 4) | (t & 0xF)
+    assert dat[2] == t >> 4
+    assert dat[7] == (aux << 2) | (~aux & 0x3)
+  # out-of-range commands clip to the 12-bit field
+  assert nissancan.create_accel_command(-5, 0, True).dat == nissancan.create_accel_command(0, 0, True).dat
+  assert nissancan.create_accel_command(9999, 0, True).dat == nissancan.create_accel_command(4095, 0, True).dat
+
