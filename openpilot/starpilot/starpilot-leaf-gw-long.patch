+  def test_gateway_heartbeat_rx_check(self):
+    # no heartbeat on bus 2 -> rx checks invalid; the stock frames alone are not enough
+    self._rx_stock_checks()
+    self.assertFalse(self.safety.safety_config_valid())
+    for bus in (0, 1):
+      self._rx(self._heartbeat_msg(bus=bus))
+      self.assertFalse(self.safety.safety_config_valid())
+    self._rx(self._heartbeat_msg(bus=2))
+    self.assertTrue(self.safety.safety_config_valid())
