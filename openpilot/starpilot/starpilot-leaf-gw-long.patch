+  gw = CarInterface.get_params(candidate, gw_fingerprint(), car_fw, True, False, False, None)
+
+  assert stock.alphaLongitudinalAvailable
+  assert not stock.openpilotLongitudinalControl
+  assert stock.pcmCruise
+  assert stock.safetyConfigs[-1].safetyParam == 0
+
+  assert gw.alphaLongitudinalAvailable
+  assert gw.openpilotLongitudinalControl
+  # stock ProPILOT engagement gates control (ADAS stays live), like Toyota/Honda Nidec long
+  assert gw.pcmCruise
+  assert not gw.autoResumeSng
+  assert gw.safetyConfigs[-1].safetyParam == NissanSafetyFlags.LEAF_GW_LONG
+  assert CarInterface.get_pid_accel_limits(gw, 0, 0) == (CarControllerParams.ACCEL_MIN, CarControllerParams.ACCEL_MAX)
