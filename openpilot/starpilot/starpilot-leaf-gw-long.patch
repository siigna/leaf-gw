+def test_leaf_accel_command_nibble_layout():
+  # V = raw12, I = ~V: byte0 = I & 0xFF, byte1 = V_hi:V_lo, byte2 = I_hi:V_mid
+  for raw12 in range(0x1000):
+    dat = nissancan.create_accel_command(raw12 * 4, 0, True).dat
+    inverse = (~raw12) & 0xFFF
+    assert dat[0] == inverse & 0xFF
+    assert dat[1] == ((raw12 >> 8) << 4) | (raw12 & 0xF)
+    assert dat[2] == ((inverse >> 8) << 4) | ((raw12 >> 4) & 0xF)
