+  def test_aux_only_with_brake_marker(self):
+    self.safety.set_controls_allowed(True)
+    for t, aux in ((2528, 2), (3415, 0)):
+      dat = bytearray(self._accel_msg(t).data)
+      dat[7] = (aux << 2) | (~aux & 0x3)
+      self.assertFalse(self._tx(common.make_msg(2, 0x2b0, 8, bytes(dat))), t)
