+  def _heartbeat_msg(self, bus=2, counter=0):
+    dat = bytearray(b"LGW\x01\x01") + bytes([counter & 0xF, 0])
+    return common.make_msg(bus, 0x5ff, 8, bytes(dat) + bytes([(0xFF + sum(dat)) & 0xFF]))
+
+  def _rx_stock_checks(self):
+    # one frame for each stock Leaf rx check (heartbeat excluded)
+    for bus, addr, length in ((0, 0x2, 5), (0, 0x285, 8), (2, 0x30f, 3), (0, 0x239, 8), (0, 0x1cc, 4)):
+      self._rx(common.make_msg(bus, addr, length, bytes(length)))
