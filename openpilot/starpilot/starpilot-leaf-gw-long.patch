+  def test_stock_frames(self):
+    # golden stock ZE1 frames decode to the limits: idle == inactive, brake marker == min
+    self.safety.set_controls_allowed(False)
+    self.assertTrue(self._tx(common.make_msg(2, 0x2b0, 8, bytes.fromhex("dc53a2ac1b000e03"))))
+    self.assertFalse(self._tx(common.make_msg(2, 0x2b0, 8, bytes.fromhex("a827d5ac5b000e09"))))
+    self.safety.set_controls_allowed(True)
+    self.assertTrue(self._tx(common.make_msg(2, 0x2b0, 8, bytes.fromhex("a827d5ac5b000e09"))))
+    self.assertTrue(self._tx(common.make_msg(2, 0x2b0, 8, bytes.fromhex("ff6090ac5b000e03"))))
+
+  def test_silencing_flag_takes_precedence(self):
+    # car side never sets both; if it did, the silencing mode's bus-1 + 0x707 path wins
+    self.safety.set_safety_hooks(CarParams.SafetyModel.nissan, NissanSafetyFlags.LONG_CONTROL | NissanSafetyFlags.LEAF_GW_LONG)
+    self.safety.set_controls_allowed(True)
+    self.assertFalse(self._tx(self._accel_msg(2528, bus=2)))
+    self.assertFalse(self._tx(self._brake_msg(200, bus=2)))
+    self.assertTrue(self._tx(self._accel_msg(2528, bus=1)))
+    self.assertTrue(self._tx(self._make_msg(nissancan.create_leaf_adas_tester_present())))
